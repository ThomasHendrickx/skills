  {"a": 0, "b": 4.4, "g": "Intro", "h": "How a trierarch keeps your ships crewed.", "s": "What the trierarch and its plugin do, and when to use them."},
  {"a": 4.4, "b": 14.4, "g": "By hand", "h": "By hand: four steps for every ship."},
  {"a": 14.4, "b": 19.4, "g": "By hand", "h": "The same four steps, for each ship."},
  {"a": 19.4, "b": 25.0, "g": "By hand", "h": "At night a session ends. Nobody restarts it."},
  {"a": 25.0, "b": 32.0, "g": "By hand", "h": "You notice at 08:30 and start it again."},
  {"a": 32.0, "b": 36.0, "g": "The switch", "h": "Same ships. Now with a trierarch."},
  {"a": 36.0, "b": 42.4, "g": "How it works", "h": "Two parts: one plugin, a trierarch per computer."},
  {"a": 42.4, "b": 49.0, "g": "How it works", "h": "A computer joins with one setup line."},
  {"a": 49.0, "b": 58.0, "g": "How it works", "h": "One crew request per ship. The plugin places it."},
  {"a": 58.0, "b": 65.0, "g": "How it works", "h": "The trierarch crews it. The secret stays out."},
  {"a": 65.0, "b": 70.0, "g": "How it works", "h": "A message arrives: the idle session wakes."},
  {"a": 70.0, "b": 74.6, "g": "How it works", "h": "A session ends at night. It restarts itself."},
  {"a": 74.6, "b": 78.6, "g": "How it works", "h": "Five restarts in an hour? You are told."},
  {"a": 78.6, "b": 84.0, "g": "How it works", "h": "Remove the request: the ship is released."},
  {"a": 84.0, "b": 94.0, "g": "The proof", "h": ""},
  {"a": 94.0, "b": 116.0, "g": "Use it or not", "h": ""},
  {"a": 116.0, "b": 122, "g": "End", "h": ""}
