+++ repo/tests/test_order_summary.py	2026-11-06 11:56:32.106114425 +0100
@@ -0,0 +1,31 @@
+import unittest
+from decimal import Decimal
+
+from src.adapters.memory import InMemoryOrders
+from src.adapters.prisma_orders import PrismaOrders
+from src.core.orders import Order, OrderStatus, order_summary
+from prismalike import OrderModel
+
+
+class SummaryTest(unittest.TestCase):
+    def test_stored_order(self):
+        fake = InMemoryOrders([Order(1, Decimal("19.99"), OrderStatus.PAID)])
+        o = order_summary(fake, 1)
+        self.assertEqual((o.total, o.status), (Decimal("19.99"), OrderStatus.PAID))
+
+    def test_unknown(self):
+        with self.assertRaises(LookupError):
+            order_summary(InMemoryOrders(), 9)
+
+
+class FakeClient:
+    def order_find_unique(self, where):
+        return OrderModel(1, 1999, 1) if where["id"] == 1 else None
+
+
+class AdapterTest(unittest.TestCase):
+    def test_mapping(self):
+        o = PrismaOrders(FakeClient()).order_by_id(1)
+        self.assertEqual((o.total, o.status), (Decimal("19.99"), OrderStatus.PAID))
+        with self.assertRaises(LookupError):
+            PrismaOrders(FakeClient()).order_by_id(2)
