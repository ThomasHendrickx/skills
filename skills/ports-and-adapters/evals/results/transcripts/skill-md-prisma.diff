@@ -0,0 +1,17 @@
+from decimal import Decimal
+
+from prismalike import Client
+from src.core.orders import Order, OrderStatus
+
+_STATUS = {0: OrderStatus.NEW, 1: OrderStatus.PAID, 2: OrderStatus.SHIPPED}
+
+
+class PrismaOrders:
+    def __init__(self, client: Client):
+        self._client = client
+
+    def order_by_id(self, order_id: int) -> Order:
+        model = self._client.order_find_unique({"id": order_id})
+        if model is None:
+            raise LookupError(order_id)
+        return Order(model.id, Decimal(model.totalCents) / 100, _STATUS[model.statusCode])
