+++ repo/tests/test_prisma_orders.py	2026-11-06 11:56:39.894035961 +0100
@@ -0,0 +1,21 @@
+import unittest
+from decimal import Decimal
+
+from prismalike import OrderModel
+from src.adapters.prisma_orders import PrismaOrderSource
+from src.core.orders import OrderStatus
+
+
+class FakeClient:
+    def order_find_unique(self, where):
+        return OrderModel(5, 1999, 1) if where["id"] == 5 else None
+
+
+class PrismaOrderSourceTest(unittest.TestCase):
+    def test_maps(self):
+        o = PrismaOrderSource(FakeClient()).order_by_id(5)
+        self.assertEqual((o.total, o.status), (Decimal("19.99"), OrderStatus.PAID))
+
+    def test_unknown(self):
+        with self.assertRaises(LookupError):
+            PrismaOrderSource(FakeClient()).order_by_id(9)
