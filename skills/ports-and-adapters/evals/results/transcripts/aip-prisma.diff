+++ repo/tests/test_summary.py	2026-11-06 11:56:39.893035971 +0100
@@ -0,0 +1,17 @@
+import unittest
+from decimal import Decimal
+
+from src.adapters.memory_orders import InMemoryOrderSource
+from src.core.orders import Order, OrderStatus
+from src.core.summary import order_summary
+
+
+class OrderSummaryTest(unittest.TestCase):
+    def test_stored_order(self):
+        src = InMemoryOrderSource([Order(7, Decimal("19.99"), OrderStatus.PAID)])
+        o = order_summary(src, 7)
+        self.assertEqual((o.total, o.status), (Decimal("19.99"), OrderStatus.PAID))
+
+    def test_unknown(self):
+        with self.assertRaises(LookupError):
+            order_summary(InMemoryOrderSource(), 1)
