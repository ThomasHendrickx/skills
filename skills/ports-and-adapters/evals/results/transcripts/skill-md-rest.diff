@@ -0,0 +1,16 @@
+import unittest
+
+from src.adapters import mcp
+
+
+class PriceOrderToolTest(unittest.TestCase):
+    def test_no_coupon(self):
+        self.assertEqual(mcp.price_order({"items": [{"cents": 10000, "qty": 1}]})["total_cents"], 9000)
+
+    def test_vip_coupon(self):
+        r = mcp.price_order({"items": [{"cents": 10000, "qty": 1}], "coupon": "VIP1"})
+        self.assertEqual(r["total_cents"], 8500)
+
+    def test_negative_total_is_error_result(self):
+        r = mcp.price_order({"items": [{"cents": -5, "qty": 1}]})
+        self.assertTrue(r["isError"])
