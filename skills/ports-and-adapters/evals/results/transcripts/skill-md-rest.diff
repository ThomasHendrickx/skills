@@ -0,0 +1,36 @@
+"""Inbound port and rules for pricing an order."""
+from dataclasses import dataclass
+
+
+class NegativeTotal(Exception):
+    pass
+
+
+@dataclass(frozen=True)
+class Item:
+    cents: int
+    qty: int
+
+
+@dataclass(frozen=True)
+class PriceOrder:
+    items: tuple
+    coupon: str = ""
+
+
+@dataclass(frozen=True)
+class Priced:
+    total_cents: int
+    discount: float
+
+
+def price_order(cmd):
+    total = sum(i.cents * i.qty for i in cmd.items)
+    if total < 0:
+        raise NegativeTotal("negative total")
+    discount = 0.0
+    if total >= 10000:
+        discount += 0.10
+    if cmd.coupon.startswith("VIP"):
+        discount += 0.05
+    return Priced(round(total * (1 - discount)), discount)
