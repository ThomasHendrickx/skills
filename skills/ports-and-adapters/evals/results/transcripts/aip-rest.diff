+"""MCP driving adapter: tool price_order. Translation only."""
+from src.core.pricing import NegativeTotal, price_order
+
+
+def price_order_tool(arguments):
+    try:
+        items = [(i["cents"], i["qty"]) for i in arguments["items"]]
+        priced = price_order(items, arguments.get("coupon", ""))
+    except NegativeTotal as e:
+        return {"isError": True, "error": str(e)}
+    except (KeyError, TypeError) as e:
+        return {"isError": True, "error": f"invalid input: {e}"}
+    return {"isError": False, "total_cents": priced.total_cents, "discount": priced.discount}
