@@ -0,0 +1,25 @@
+"""Inbound port: price an order. Owns the discount rules."""
+from dataclasses import dataclass
+
+
+class NegativeTotal(Exception):
+    pass
+
+
+@dataclass(frozen=True)
+class PricedOrder:
+    total_cents: int
+    discount: float
+
+
+def price_order(items, coupon=""):
+    """items: iterable of (cents, qty). Raises NegativeTotal."""
+    total = sum(cents * qty for cents, qty in items)
+    if total < 0:
+        raise NegativeTotal("negative total")
+    discount = 0.0
+    if total >= 10000:
+        discount += 0.10
+    if coupon.startswith("VIP"):
+        discount += 0.05
+    return PricedOrder(round(total * (1 - discount)), discount)
