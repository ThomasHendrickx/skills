@@ -0,0 +1,21 @@
+import unittest
+
+from src.adapters import mcp
+from src.main import MCP_TOOLS
+
+
+class PriceOrderToolTest(unittest.TestCase):
+    def test_registered(self):
+        self.assertIs(MCP_TOOLS["price_order"], mcp.price_order_tool)
+
+    def test_big_order_discount(self):
+        r = mcp.price_order_tool({"items": [{"cents": 10000, "qty": 1}]})
+        self.assertEqual(r["total_cents"], 9000)
+
+    def test_vip_coupon(self):
+        r = mcp.price_order_tool({"items": [{"cents": 10000, "qty": 1}], "coupon": "VIP1"})
+        self.assertEqual(r["total_cents"], 8500)
+
+    def test_negative_total_is_error_result(self):
+        r = mcp.price_order_tool({"items": [{"cents": -5, "qty": 1}]})
+        self.assertTrue(r["isError"])
