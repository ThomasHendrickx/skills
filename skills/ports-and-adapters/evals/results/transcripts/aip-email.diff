+
+from src.adapters.fake_mailer import InMemoryMailer
+from src.core.invoices import remind_overdue
+
+
+class RemindOverdueTest(unittest.TestCase):
+    def setUp(self):
+        self.mailer = InMemoryMailer()
+
+    def test_unpaid_past_due_sends_one(self):
+        remind_overdue(Invoice("7", "a@b.c", date(2026, 1, 1)), date(2026, 2, 1), self.mailer)
+        self.assertEqual(self.mailer.sent, [("a@b.c", "7")])
+
+    def test_paid_sends_none(self):
+        remind_overdue(Invoice("7", "a@b.c", date(2026, 1, 1), paid=True), date(2026, 2, 1), self.mailer)
+        self.assertEqual(self.mailer.sent, [])
+
+    def test_not_yet_due_sends_none(self):
+        remind_overdue(Invoice("7", "a@b.c", date(2026, 3, 1)), date(2026, 2, 1), self.mailer)
+        self.assertEqual(self.mailer.sent, [])
+
+    def test_subject_in_adapter(self):
+        import email_sdk
+        from unittest import mock
+        from src.adapters.email_sdk_mailer import EmailSdkMailer
+        with mock.patch.object(email_sdk.Client, "send") as send:
+            EmailSdkMailer("k").send_overdue_reminder("a@b.c", "7")
+        self.assertEqual(send.call_args.args[:2], ("a@b.c", "Invoice 7 is overdue"))
