+def remind_overdue(invoice: Invoice, today: date, mailer) -> None:
+    """Send one reminder if the invoice is unpaid and past its due date."""
+    if invoice.paid or today <= invoice.due:
+        return
+    mailer.send_overdue_reminder(invoice.customer_email, invoice.id)
