@@ -0,0 +1,14 @@
+"""Driven adapter: ReminderMailer over the vendor email SDK. Mapping to SDK terms lives here."""
+import email_sdk
+
+
+class EmailSdkMailer:
+    def __init__(self, api_key):
+        self._client = email_sdk.Client(api_key)
+
+    def send_overdue_reminder(self, customer_email, invoice_id):
+        self._client.send(
+            customer_email,
+            f"Invoice {invoice_id} is overdue",
+            f"Invoice {invoice_id} is overdue. Please pay it as soon as possible.",
+        )
