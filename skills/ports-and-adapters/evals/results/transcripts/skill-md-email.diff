@@ -0,0 +1,24 @@
+import unittest
+from datetime import date
+
+from src.adapters.in_memory_mailer import InMemoryOverdueReminders
+from src.core.invoices import Invoice, remind_overdue
+
+TODAY = date(2026, 6, 1)
+
+
+class RemindOverdueTest(unittest.TestCase):
+    def setUp(self):
+        self.mailer = InMemoryOverdueReminders()
+
+    def test_unpaid_past_due_sends_one(self):
+        remind_overdue(Invoice("7", "a@b.c", date(2026, 5, 1)), TODAY, self.mailer)
+        self.assertEqual(self.mailer.sent, [("a@b.c", "7")])
+
+    def test_paid_sends_none(self):
+        remind_overdue(Invoice("7", "a@b.c", date(2026, 5, 1), paid=True), TODAY, self.mailer)
+        self.assertEqual(self.mailer.sent, [])
+
+    def test_not_yet_due_sends_none(self):
+        remind_overdue(Invoice("7", "a@b.c", date(2026, 7, 1)), TODAY, self.mailer)
+        self.assertEqual(self.mailer.sent, [])
