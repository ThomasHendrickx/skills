@@ -0,0 +1,29 @@
+import unittest
+from datetime import date
+
+from src.adapters import rest_refunds
+from src.core import refunds
+
+TODAY = date(2026, 1, 10)
+PAID = date(2026, 1, 1)
+
+
+def body(amount, paid=100000, paid_on=PAID):
+    return {"amount_cents": amount, "paid_cents": paid, "paid_on": paid_on}
+
+
+class RefundScenarios(unittest.TestCase):
+    def test_above_threshold_is_pending(self):
+        self.assertEqual(rest_refunds.post_refund(body(50001), TODAY)[0], 202)
+        self.assertEqual(rest_refunds.post_refund(body(50001), TODAY)[1]["status"], "pending_approval")
+
+    def test_at_threshold_refunded(self):
+        self.assertEqual(rest_refunds.post_refund(body(50000), TODAY)[0], 200)
+
+    def test_existing_outcomes(self):
+        self.assertEqual(rest_refunds.post_refund(body(0), TODAY)[0], 422)
+        self.assertEqual(rest_refunds.post_refund(body(100, paid_on=date(2025, 12, 1)), TODAY)[0], 409)
+        self.assertEqual(rest_refunds.post_refund(body(200, paid=100), TODAY)[0], 409)
+
+    def test_use_case_direct(self):
+        self.assertEqual(refunds.request_refund(50001, 90000, PAID, TODAY).kind, "pending_approval")
