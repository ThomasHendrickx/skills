+"""Refund use case: the inbound port for requesting a refund."""
+from dataclasses import dataclass
+from datetime import date
+
+APPROVAL_THRESHOLD_CENTS = 50000
+WINDOW_DAYS = 30
+
+
+@dataclass(frozen=True)
+class RefundOutcome:
+    kind: str  # refunded | pending_approval | invalid_amount | window_closed | exceeds_payment
+    amount_cents: int = 0
+
+
+def request_refund(amount_cents: int, paid_cents: int, paid_on: date, today: date) -> RefundOutcome:
+    if amount_cents <= 0:
+        return RefundOutcome("invalid_amount")
+    if (today - paid_on).days > WINDOW_DAYS:
+        return RefundOutcome("window_closed")
+    if amount_cents > paid_cents:
+        return RefundOutcome("exceeds_payment")
+    if amount_cents > APPROVAL_THRESHOLD_CENTS:
+        return RefundOutcome("pending_approval", amount_cents)
+    return RefundOutcome("refunded", amount_cents)
