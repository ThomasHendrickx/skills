+"""Refund use case (inbound port): the refund rules, free of transport."""
+from dataclasses import dataclass
+from datetime import date
+
+REFUND_WINDOW_DAYS = 30
+APPROVAL_THRESHOLD_CENTS = 50000
+
+
+@dataclass(frozen=True)
+class RefundCommand:
+    amount_cents: int
+    paid_cents: int
+    paid_on: date
+
+
+@dataclass(frozen=True)
+class RefundOutcome:
+    status: str  # refunded | pending_approval | rejected
+    amount_cents: int = 0
+    reason: str = ""  # invalid_amount | window_closed | exceeds_payment when rejected
+
+
+def request_refund(command: RefundCommand, today: date) -> RefundOutcome:
+    if command.amount_cents <= 0:
+        return RefundOutcome("rejected", reason="invalid_amount")
+    if (today - command.paid_on).days > REFUND_WINDOW_DAYS:
+        return RefundOutcome("rejected", reason="window_closed")
+    if command.amount_cents > command.paid_cents:
+        return RefundOutcome("rejected", reason="exceeds_payment")
+    if command.amount_cents > APPROVAL_THRESHOLD_CENTS:
+        return RefundOutcome("pending_approval", command.amount_cents)
+    return RefundOutcome("refunded", command.amount_cents)
