@@ -0,0 +1,25 @@
+import unittest
+from datetime import date
+
+from src.adapters import rest_refunds
+
+TODAY = date(2026, 3, 1)
+
+
+def post(amount, paid=100000, paid_on=date(2026, 2, 20)):
+    return rest_refunds.post_refund(
+        {"amount_cents": amount, "paid_cents": paid, "paid_on": paid_on}, TODAY)
+
+
+class RefundScenarios(unittest.TestCase):
+    def test_above_threshold_is_pending_approval(self):
+        self.assertEqual(post(50001), (202, {"status": "pending_approval", "amount_cents": 50001}))
+
+    def test_at_threshold_is_refunded(self):
+        self.assertEqual(post(50000), (200, {"status": "refunded", "amount_cents": 50000}))
+
+    def test_existing_outcomes(self):
+        self.assertEqual(post(0)[0], 422)
+        self.assertEqual(post(100, paid_on=date(2026, 1, 1))[0], 409)
+        self.assertEqual(post(200, paid=100), (409, {"error": "refund exceeds payment"}))
+        self.assertEqual(post(100), (200, {"status": "refunded", "amount_cents": 100}))
