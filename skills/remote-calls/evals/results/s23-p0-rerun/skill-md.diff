+++ repo/tests/sdk-budget.test.mjs	2026-11-09 13:57:31.653148035 +0100
@@ -0,0 +1,20 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { makeVendor } from '../src/adapters/vendor.js';
+import { Network } from '../src/infra/network.js';
+
+test('failed availability read stays within three SDK attempts', async () => {
+ const network = new Network(Array.from({length: 6}, () => ({status:503})));
+ await assert.rejects(makeVendor(network).lookup('sku'));
+ assert.equal(network.requests.length, 3);
+});
+test('SDK can recover on its third attempt', async () => {
+ const network = new Network([{status:503},{status:503},{status:200,value:{available:true}}]);
+ assert.deepEqual(await makeVendor(network).lookup('sku'), {available:true});
+ assert.equal(network.requests.length, 3);
+});
+test('charge remains a single attempt', async () => {
+ const network = new Network([{status:503}]);
+ await assert.rejects(makeVendor(network).charge({id:'order'}));
+ assert.equal(network.requests.length, 1);
+});
