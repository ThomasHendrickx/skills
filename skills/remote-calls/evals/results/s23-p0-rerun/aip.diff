diff -ruN '--exclude=node_modules' '--exclude=__pycache__' base/tests/sdk-attempt-budget.test.mjs repo/tests/sdk-attempt-budget.test.mjs
--- base/tests/sdk-attempt-budget.test.mjs	1970-01-01 01:00:00.000000000 +0100
+++ repo/tests/sdk-attempt-budget.test.mjs	2026-11-09 13:57:35.003113996 +0100
@@ -0,0 +1,22 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { makeVendor } from '../src/adapters/vendor.js';
+import { Network } from '../src/infra/network.js';
+
+test('lookup stops after the SDK three-attempt budget', async () => {
+  const network = new Network(Array.from({length: 6}, () => ({status: 503})));
+  await assert.rejects(makeVendor(network).lookup('sku'), {status: 503});
+  assert.equal(network.requests.length, 3);
+});
+
+test('lookup can recover on the SDK final attempt', async () => {
+  const network = new Network([{status: 503}, {status: 503}, {status: 200, value: {available: true}}]);
+  assert.deepEqual(await makeVendor(network).lookup('sku'), {available: true});
+  assert.equal(network.requests.length, 3);
+});
+
+test('unkeyed charge remains a single attempt', async () => {
+  const network = new Network([{status: 503}, {status: 200}]);
+  await assert.rejects(makeVendor(network).charge({id: 'order'}), {status: 503});
+  assert.equal(network.requests.length, 1);
+});
