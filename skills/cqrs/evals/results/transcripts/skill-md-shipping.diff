diff -ruN -x __pycache__ -x '*.pyc' -x database.url base/src/shipping/relay.py repo/src/shipping/relay.py
--- base/src/shipping/relay.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/src/shipping/relay.py	2026-11-07 17:17:18.332773194 +0100
@@ -0,0 +1,35 @@
+"""Shipping's outbox relay: publishes unpublished rows after commit, at least once, retrying then dead-lettering."""
+import logging
+
+from src.db import connect
+
+MAX_ATTEMPTS = 5
+log = logging.getLogger(__name__)
+
+
+def publish_pending(handler, max_attempts: int = MAX_ATTEMPTS) -> int:
+    """Hand each pending event, in order, to handler(payload). Returns how many were published.
+
+    A failing event is retried on later runs; after max_attempts it is dead-lettered with an alert (error log).
+    Rows of one shipment are never skipped past a failure, so ordering per shipment holds.
+    """
+    published = 0
+    with connect() as conn:
+        ids = [r[0] for r in conn.execute(
+            "SELECT seq FROM shipping_outbox WHERE published_at IS NULL AND NOT dead_lettered ORDER BY seq").fetchall()]
+    for seq in ids:
+        with connect() as conn:
+            event_id, payload = conn.execute("SELECT event_id, payload FROM shipping_outbox WHERE seq = %s", (seq,)).fetchone()
+            try:
+                handler(payload)
+            except Exception as error:
+                attempts = conn.execute(
+                    "UPDATE shipping_outbox SET attempts = attempts + 1, last_error = %s WHERE seq = %s RETURNING attempts",
+                    (repr(error), seq)).fetchone()[0]
+                if attempts >= max_attempts:
+                    conn.execute("UPDATE shipping_outbox SET dead_lettered = true WHERE seq = %s", (seq,))
+                    log.error("ALERT: shipping event %s dead-lettered after %s attempts: %r", event_id, attempts, error)
+                continue
+            conn.execute("UPDATE shipping_outbox SET published_at = now() WHERE seq = %s", (seq,))
+            published += 1
+    return published
