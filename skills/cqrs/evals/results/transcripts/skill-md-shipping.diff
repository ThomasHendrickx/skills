diff -ruN -x __pycache__ -x '*.pyc' -x database.url base/src/projections/rebuild.py repo/src/projections/rebuild.py
--- base/src/projections/rebuild.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/src/projections/rebuild.py	2026-11-07 17:17:18.336773154 +0100
@@ -0,0 +1,17 @@
+"""Rebuild order_shipping from Shipping's retained outbox events. Usage: python3 -m src.projections.rebuild"""
+from src.db import connect
+from src.projections.order_shipping import apply
+
+
+def rebuild() -> int:
+    with connect() as conn, conn.transaction():
+        conn.execute("DELETE FROM order_shipping")
+        conn.execute("DELETE FROM order_shipping_processed_events")
+        rows = conn.execute("SELECT payload FROM shipping_outbox WHERE NOT dead_lettered ORDER BY seq").fetchall()
+        for (payload,) in rows:
+            apply(payload, conn)
+    return len(rows)
+
+
+if __name__ == "__main__":
+    print(f"replayed {rebuild()} event(s)")
