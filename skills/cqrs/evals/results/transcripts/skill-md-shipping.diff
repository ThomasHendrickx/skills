diff -ruN -x __pycache__ -x '*.pyc' -x database.url base/src/projections/order_shipping.py repo/src/projections/order_shipping.py
--- base/src/projections/order_shipping.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/src/projections/order_shipping.py	2026-11-07 09:25:43.290875443 +0100
@@ -0,0 +1,47 @@
+"""Orders-side projection of shipping status, fed by shipping's outbox events (never reads `shipments`).
+
+Update: `apply_pending()` consumes unprocessed outbox events, each in its own transaction, idempotent on event_id.
+Rebuild: `rebuild()` empties the projection and replays every outbox event in order.
+CLI: `python3 -m src.projections.order_shipping [rebuild]`.
+"""
+import sys
+
+from src.db import connect
+
+UPSERT = """
+INSERT INTO order_shipping_status (order_id, shipment_id, status, carrier, dispatched_on)
+VALUES (%(order_id)s, %(shipment_id)s, %(status)s, %(carrier)s, %(dispatched_on)s)
+ON CONFLICT (order_id) DO UPDATE SET shipment_id = EXCLUDED.shipment_id, status = EXCLUDED.status,
+    carrier = EXCLUDED.carrier, dispatched_on = EXCLUDED.dispatched_on
+WHERE order_shipping_status.status <> 'dispatched'
+"""
+
+
+def _apply(conn, event_id, payload):
+    fresh = conn.execute("INSERT INTO order_shipping_processed (event_id) VALUES (%s) ON CONFLICT DO NOTHING RETURNING 1",
+                         (event_id,)).fetchone()
+    if fresh:
+        conn.execute(UPSERT, payload)
+
+
+def apply_pending():
+    with connect() as conn:
+        rows = conn.execute(
+            "SELECT event_id, payload FROM shipping_outbox o WHERE NOT EXISTS"
+            " (SELECT 1 FROM order_shipping_processed p WHERE p.event_id = o.event_id) ORDER BY seq").fetchall()
+        for event_id, payload in rows:
+            with conn.transaction():
+                _apply(conn, event_id, payload)
+    return len(rows)
+
+
+def rebuild():
+    with connect() as conn, conn.transaction():
+        conn.execute("DELETE FROM order_shipping_status")
+        conn.execute("DELETE FROM order_shipping_processed")
+        for event_id, payload in conn.execute("SELECT event_id, payload FROM shipping_outbox ORDER BY seq").fetchall():
+            _apply(conn, event_id, payload)
+
+
+if __name__ == "__main__":
+    rebuild() if sys.argv[1:] == ["rebuild"] else apply_pending()
