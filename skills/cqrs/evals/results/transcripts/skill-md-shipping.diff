+class PgOutbox:
+    """Published events, written in the command's transaction."""
+
+    def __init__(self, conn):
+        self.conn = conn
+
+    def publish(self, event_id, type_, payload):
+        self.conn.execute("INSERT INTO shipping_outbox (event_id, type, payload) VALUES (%s, %s, %s)",
+                          (event_id, type_, json.dumps(payload, default=str)))
+
