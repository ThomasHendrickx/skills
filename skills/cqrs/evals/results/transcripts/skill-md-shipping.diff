@@ -0,0 +1,71 @@
+from datetime import date
+
+from src import main
+from src.db import connect
+from src.projections.order_shipping import apply
+from src.projections.rebuild import rebuild
+from src.shipping.adapters.pg import ShippingUnitOfWork
+from src.shipping.core.commands import create_shipment, dispatch_shipment
+from src.shipping.relay import publish_pending
+from src.web.customer_pages import my_orders_page
+from tests.support import DbTest
+
+
+def rows():
+    with connect() as c:
+        return c.execute("SELECT order_id, shipment_version, shipping_status, carrier, dispatched_on FROM order_shipping ORDER BY order_id").fetchall()
+
+
+class OrderShippingProjectionTest(DbTest):
+    def setUp(self):
+        super().setUp()
+        self.customer("ann")
+        self.order("o1", "ann")
+
+    def test_dispatch_is_visible_right_after_command(self):
+        main.create_shipment("s1", "o1")
+        main.dispatch_shipment("s1", "bpost", date(2026, 3, 3))
+        row = my_orders_page("ann")["rows"][0]
+        self.assertEqual((row["shipping_status"], row["carrier"], row["dispatched_on"]), ("dispatched", "bpost", date(2026, 3, 3)))
+
+    def test_no_shipment_is_pending(self):
+        self.assertEqual(my_orders_page("ann")["rows"][0]["shipping_status"], "pending")
+
+    def test_rolled_back_change_writes_no_outbox_row(self):
+        main.create_shipment("s1", "o1")
+        try:
+            dispatch_shipment(ShippingUnitOfWork(), "s1", "bpost", date(2026, 3, 3)); dispatch_shipment(ShippingUnitOfWork(), "s1", "x", date(2026, 3, 4))
+        except Exception:
+            pass
+        with connect() as c:
+            self.assertEqual(c.execute("SELECT count(*) FROM shipping_outbox").fetchone()[0], 2)
+
+    def test_same_event_twice_applies_once(self):
+        create_shipment(ShippingUnitOfWork(), "s1", "o1")
+        with connect() as c:
+            payload = c.execute("SELECT payload FROM shipping_outbox").fetchone()[0]
+        apply(payload); apply(payload)
+        self.assertEqual(rows(), [("o1", 1, "pending", None, None)])
+
+    def test_older_version_after_newer_is_ignored(self):
+        create_shipment(ShippingUnitOfWork(), "s1", "o1")
+        dispatch_shipment(ShippingUnitOfWork(), "s1", "bpost", date(2026, 3, 3))
+        with connect() as c:
+            created, dispatched = [r[0] for r in c.execute("SELECT payload FROM shipping_outbox ORDER BY seq")]
+        apply(dispatched); apply(created)
+        self.assertEqual(rows(), [("o1", 2, "dispatched", "bpost", date(2026, 3, 3))])
+
+    def test_rebuild_equals_incremental(self):
+        main.create_shipment("s1", "o1")
+        main.dispatch_shipment("s1", "bpost", date(2026, 3, 3))
+        before = rows()
+        rebuild()
+        self.assertEqual(rows(), before)
+
+    def test_failing_consumer_retries_then_dead_letters(self):
+        create_shipment(ShippingUnitOfWork(), "s1", "o1")
+        def boom(_): raise RuntimeError("down")
+        for _ in range(3):
+            publish_pending(boom, max_attempts=3)
+        with connect() as c:
+            self.assertEqual(c.execute("SELECT attempts, dead_lettered FROM shipping_outbox").fetchone(), (3, True))
