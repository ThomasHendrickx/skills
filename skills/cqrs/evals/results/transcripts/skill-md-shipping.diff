@@ -0,0 +1,21 @@
+"""Integration events published by Shipping (one producer). Changes are additive; breaking change = new version.
+
+ShipmentChanged v1 (state transfer declared: consumers need the status without reading Shipping's tables):
+  event_id, name ("ShipmentCreated" | "ShipmentDispatched"), version (1), shipment_id, order_id,
+  shipment_version (int, increases per shipment), status, carrier, dispatched_on (ISO date or null)
+"""
+CONTRACT_VERSION = 1
+
+
+def shipment_changed(event_id: str, name: str, shipment) -> dict:
+    return {
+        "event_id": event_id,
+        "name": name,
+        "version": CONTRACT_VERSION,
+        "shipment_id": shipment.id,
+        "order_id": shipment.order_id,
+        "shipment_version": shipment.version,
+        "status": shipment.status,
+        "carrier": shipment.carrier,
+        "dispatched_on": shipment.dispatched_on.isoformat() if shipment.dispatched_on else None,
+    }
