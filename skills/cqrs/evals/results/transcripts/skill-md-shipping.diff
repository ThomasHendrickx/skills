@@ -0,0 +1,27 @@
+"""Orders-context projection of shipping status, fed by Shipping's ShipmentChanged v1 integration event.
+
+Update trigger: async, outbox consumer (relay runs right after the shipping command commits, and on `process`).
+Staleness bound: the relay run after commit; normally none visible, at worst until the next `process` run.
+Idempotency key: event_id, recorded in the same transaction as the effect; older shipment_version is ignored.
+Rebuild: `python3 -m src.projections.rebuild` replays every retained shipping outbox event.
+Read-your-own-writes: the shipping commands run the relay synchronously after commit (src/main.py), so a
+customer who got the dispatch notice sees it; if the relay fails, `process` retries it.
+"""
+from src.db import connect
+
+
+def apply(payload: dict, conn=None) -> None:
+    if conn is None:
+        with connect() as own, own.transaction():
+            return apply(payload, own)
+    inserted = conn.execute("INSERT INTO order_shipping_processed_events (event_id) VALUES (%s) ON CONFLICT DO NOTHING RETURNING event_id",
+                            (payload["event_id"],)).fetchone()
+    if inserted is None:
+        return
+    conn.execute(
+        """INSERT INTO order_shipping (order_id, shipment_id, shipment_version, shipping_status, carrier, dispatched_on)
+           VALUES (%(order_id)s, %(shipment_id)s, %(shipment_version)s, %(status)s, %(carrier)s, %(dispatched_on)s)
+           ON CONFLICT (order_id) DO UPDATE SET shipment_id = excluded.shipment_id, shipment_version = excluded.shipment_version,
+               shipping_status = excluded.shipping_status, carrier = excluded.carrier, dispatched_on = excluded.dispatched_on
+           WHERE order_shipping.shipment_id = excluded.shipment_id AND order_shipping.shipment_version < excluded.shipment_version""",
+        payload)
