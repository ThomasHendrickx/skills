@@ -13,3 +13,30 @@
         main.cancel_order("cy0")
         tiers = {r["customer_id"]: r["tier"] for r in customer_list()["rows"]}
         self.assertEqual(tiers, {"ann": "gold", "bob": "standard", "cy": "standard"})
+
+    def test_paging_sort_count_and_empty(self):
+        self.assertEqual(customer_list(), {"page": 1, "total": 0, "rows": []})
+        for n in range(30):
+            self.customer(f"c{n:02d}", name=f"Name {29 - n:02d}")
+        first, second = customer_list(1), customer_list(2)
+        self.assertEqual(first["total"], 30)
+        self.assertEqual(len(first["rows"]), 25)
+        self.assertEqual(len(second["rows"]), 5)
+        names = [r["name"] for r in first["rows"] + second["rows"]]
+        self.assertEqual(names, sorted(names))
+        self.assertEqual(first["rows"][0]["tier"], "standard")
+
+    def test_tier_follows_orders_and_suspension(self):
+        self.customer("ann")
+        for n in range(11):
+            self.order(f"a{n}", "ann")
+        tier = lambda: customer_list()["rows"][0]["tier"]
+        self.assertEqual(tier(), "gold")
+        main.cancel_order("a0")
+        self.assertEqual(tier(), "standard")
+        self.order("a11", "ann")
+        self.assertEqual(tier(), "gold")
+        main.suspend_customer("ann")
+        self.assertEqual(tier(), "standard")
+        main.reinstate_customer("ann")
+        self.assertEqual(tier(), "gold")
