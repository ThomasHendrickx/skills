diff -ruN -x __pycache__ -x '*.pyc' -x database.url base/tests/test_change_shipping_address.py repo/tests/test_change_shipping_address.py
--- base/tests/test_change_shipping_address.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/tests/test_change_shipping_address.py	2026-11-07 09:25:36.480944356 +0100
@@ -0,0 +1,43 @@
+from src import main
+from src.adapters.pg_unit_of_work import PgUnitOfWork
+from src.core.orders import Address, OrderError
+from tests.support import HOME, DbTest
+
+
+def load(order_id):
+    with PgUnitOfWork() as uow:
+        return uow.orders.get(order_id)
+
+
+class ChangeShippingAddressTest(DbTest):
+    def setUp(self):
+        super().setUp()
+        self.customer("ann")
+        self.order("o1", "ann", lines=(("A", 2, 1000),))
+
+    def test_address_changes_and_version_returned(self):
+        version = main.change_shipping_address("o1", "2 Side St", "Antwerp", "2000")
+        self.assertEqual(load("o1").shipping_address, Address("2 Side St", "Antwerp", "2000"))
+        self.assertEqual(version, 2)
+
+    def test_other_fields_untouched(self):
+        main.change_shipping_address("o1", "2 Side St", "Antwerp", "2000")
+        order = load("o1")
+        self.assertEqual(order.total_cents, 2000)
+        self.assertEqual(order.status, "placed")
+        self.assertEqual(order.note, "")
+
+    def test_shipped_order_address_does_not_change(self):
+        main.ship_order("o1")
+        with self.assertRaises(OrderError):
+            main.change_shipping_address("o1", "2 Side St", "Antwerp", "2000")
+        self.assertEqual(load("o1").shipping_address, HOME)
+
+    def test_cancelled_order_address_does_not_change(self):
+        with PgUnitOfWork() as uow:
+            order = uow.orders.get("o1")
+            order.cancel()
+            uow.orders.save(order)
+        with self.assertRaises(OrderError):
+            main.change_shipping_address("o1", "2 Side St", "Antwerp", "2000")
+        self.assertEqual(load("o1").shipping_address, HOME)
