+    def test_empty(self):
+        self.customer("ann")
+        page = customer_totals_page()
+        self.assertEqual((page["rows"], page["total"]), ([], 0))
+
+    def test_cancelled_orders_do_not_count(self):
+        self.customer("ann")
+        self.order("o1", "ann", lines=(("A", 1, 1000),))
+        self.order("o2", "ann", lines=(("A", 5, 1000),))
+        with PgUnitOfWork() as uow:
+            order = uow.orders.get("o2")
+            order.cancel()
+            uow.orders.save(order)
+        page = customer_totals_page()
+        self.assertEqual([(r["orders"], r["total_cents"]) for r in page["rows"]], [(1, 1000)])
+        self.assertEqual(page["total"], 1)
+
+    def test_multi_line_order_counts_once(self):
+        self.customer("ann")
+        self.order("o1", "ann", lines=(("A", 2, 500), ("B", 1, 250)))
+        row = customer_totals_page()["rows"][0]
+        self.assertEqual((row["orders"], row["total_cents"]), (1, 1250))
+
