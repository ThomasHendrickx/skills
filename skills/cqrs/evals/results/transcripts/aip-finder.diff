--- base/tests/test_customer_orders.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/tests/test_customer_orders.py	2026-11-07 09:25:42.752880887 +0100
@@ -0,0 +1,53 @@
+from datetime import date
+
+from src.queries.customer_orders import my_orders
+from tests.support import DbTest
+
+
+class MyOrdersQueryTest(DbTest):
+    def setUp(self):
+        super().setUp()
+        self.customer("ann")
+        self.customer("bob")
+
+    def fill(self, n):
+        for day in range(1, n + 1):
+            self.order(f"o{day:02}", "ann", placed_on=date(2026, 3, day), lines=(("A", 1, 100 * day), ("B", 2, 10)))
+
+    def test_shape_and_total(self):
+        self.fill(1)
+        page = my_orders("ann")
+        self.assertEqual(len(page.rows), 1)
+        row = page.rows[0]
+        self.assertEqual((row.number, row.placed_on, row.status, row.total_cents), ("N-o01", date(2026, 3, 1), "placed", 120))
+
+    def test_empty(self):
+        page = my_orders("ann")
+        self.assertEqual((page.rows, page.total, page.has_more), ([], 0, False))
+
+    def test_newest_first_and_only_own_orders(self):
+        self.fill(3)
+        self.order("b1", "bob")
+        self.assertEqual([r.number for r in my_orders("ann").rows], ["N-o03", "N-o02", "N-o01"])
+
+    def test_first_page_has_ten_and_more(self):
+        self.fill(12)
+        page = my_orders("ann")
+        self.assertEqual(len(page.rows), 10)
+        self.assertEqual((page.total, page.has_more), (12, True))
+
+    def test_next_page(self):
+        self.fill(12)
+        page = my_orders("ann", 2)
+        self.assertEqual([r.number for r in page.rows], ["N-o02", "N-o01"])
+        self.assertFalse(page.has_more)
+
+    def test_exactly_ten_has_no_more(self):
+        self.fill(10)
+        self.assertFalse(my_orders("ann").has_more)
+
+    def test_status_change_is_visible(self):
+        self.fill(1)
+        from src import main
+        main.ship_order("o01")
+        self.assertEqual(my_orders("ann").rows[0].status, "shipped")
