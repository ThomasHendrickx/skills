--- base/src/queries/customer_orders.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/src/queries/customer_orders.py	2026-11-07 09:25:42.748880928 +0100
@@ -0,0 +1,34 @@
+"""Query: a customer's 'My orders' list. Reads the tables directly; returns read types only."""
+from dataclasses import dataclass
+from datetime import date
+
+from src.db import connect
+
+PAGE_SIZE = 10
+
+
+@dataclass(frozen=True)
+class OrderRow:
+    number: str
+    placed_on: date
+    status: str
+    total_cents: int
+
+
+@dataclass(frozen=True)
+class OrdersPage:
+    rows: list
+    page: int
+    total: int
+    has_more: bool
+
+
+def my_orders(customer_id, page=1):
+    page = max(1, page)
+    with connect() as conn:
+        rows = conn.execute(
+            "SELECT number, placed_on, status, total_cents FROM orders WHERE customer_id = %s"
+            " ORDER BY placed_on DESC, number DESC LIMIT %s OFFSET %s",
+            (customer_id, PAGE_SIZE, (page - 1) * PAGE_SIZE)).fetchall()
+        total = conn.execute("SELECT count(*) FROM orders WHERE customer_id = %s", (customer_id,)).fetchone()[0]
+    return OrdersPage([OrderRow(*r) for r in rows], page, total, page * PAGE_SIZE < total)
