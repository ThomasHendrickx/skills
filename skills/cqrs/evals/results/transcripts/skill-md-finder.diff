+def my_orders_page(customer_id, page=1):
+    """Customer's 'My orders' page: 10 orders per page, newest first; has_more drives the 'show more' link."""
+    result = my_orders(customer_id, page)
+    return {"rows": [{"number": r.number, "placed_on": r.placed_on.isoformat(), "status": r.status, "total_cents": r.total_cents}
+                     for r in result.rows],
+            "has_more": result.has_more, "next_page": page + 1 if result.has_more else None}
