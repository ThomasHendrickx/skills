--- base/src/queries/my_orders.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/src/queries/my_orders.py	2026-11-07 09:25:36.003949182 +0100
@@ -0,0 +1,33 @@
+from dataclasses import dataclass
+from datetime import date
+
+from src.db import connect
+
+PAGE_SIZE = 10
+
+
+@dataclass(frozen=True)
+class MyOrderRow:
+    number: str
+    placed_on: date
+    status: str
+    total_cents: int
+
+
+@dataclass(frozen=True)
+class MyOrdersPage:
+    rows: list
+    has_more: bool
+
+
+def my_orders(customer_id: str, page: int = 1) -> MyOrdersPage:
+    """A customer's orders, newest first, PAGE_SIZE per page (pages start at 1)."""
+    page = max(page, 1)
+    with connect() as conn:
+        found = conn.execute(
+            "SELECT o.number, o.placed_on, o.status, COALESCE(SUM(l.quantity * l.unit_price_cents), 0)"
+            " FROM orders o LEFT JOIN order_lines l ON l.order_id = o.id"
+            " WHERE o.customer_id = %s GROUP BY o.id"
+            " ORDER BY o.placed_on DESC, o.number DESC LIMIT %s OFFSET %s",
+            (customer_id, PAGE_SIZE + 1, (page - 1) * PAGE_SIZE)).fetchall()
+    return MyOrdersPage([MyOrderRow(*r) for r in found[:PAGE_SIZE]], len(found) > PAGE_SIZE)
