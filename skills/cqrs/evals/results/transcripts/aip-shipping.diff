diff -ruN -x __pycache__ -x '*.pyc' -x database.url base/tests/test_order_shipping_projection.py repo/tests/test_order_shipping_projection.py
--- base/tests/test_order_shipping_projection.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/tests/test_order_shipping_projection.py	2026-11-07 18:02:51.315786665 +0100
@@ -0,0 +1,74 @@
+from datetime import date
+
+from src import main
+from src.db import connect
+from src.projections import order_shipping
+from src.web.customer_pages import my_orders_page
+from tests.support import DbTest
+
+
+def rows_of_projection():
+    with connect() as conn:
+        return conn.execute("SELECT order_id, shipment_id, status, carrier, dispatched_on, version FROM order_shipping_status ORDER BY order_id").fetchall()
+
+
+class ShippingProjectionTest(DbTest):
+    def setUp(self):
+        super().setUp()
+        self.customer("ann")
+        self.order("o1", "ann")
+
+    def test_dispatch_visible_immediately(self):
+        main.create_shipment("s1", "o1")
+        main.dispatch_shipment("s1", "bpost", date(2026, 3, 3))
+        row = my_orders_page("ann")["rows"][0]
+        self.assertEqual((row["shipping_status"], row["carrier"], row["dispatched_on"]), ("dispatched", "bpost", date(2026, 3, 3)))
+
+    def test_order_without_shipment_is_pending(self):
+        self.assertEqual(my_orders_page("ann")["rows"][0]["shipping_status"], "pending")
+
+    def test_redelivery_applies_once(self):
+        main.create_shipment("s1", "o1")
+        main.dispatch_shipment("s1", "bpost", date(2026, 3, 3))
+        before = rows_of_projection()
+        with connect() as conn:
+            conn.execute("UPDATE shipping_outbox SET published_at = NULL")
+        order_shipping.process()
+        self.assertEqual(rows_of_projection(), before)
+
+    def test_older_event_after_newer_is_ignored(self):
+        main.create_shipment("s1", "o1")
+        main.dispatch_shipment("s1", "bpost", date(2026, 3, 3))
+        with connect() as conn:
+            payload = conn.execute("SELECT payload FROM shipping_outbox WHERE event_type = 'ShipmentCreated'").fetchone()[0]
+            order_shipping.apply(999, payload, conn)
+        self.assertEqual(rows_of_projection()[0][2], "dispatched")
+
+    def test_rebuild_equals_incremental(self):
+        self.order("o2", "ann", number="N-o2")
+        main.create_shipment("s1", "o1")
+        main.create_shipment("s2", "o2")
+        main.dispatch_shipment("s1", "bpost", date(2026, 3, 3))
+        incremental = rows_of_projection()
+        order_shipping.rebuild()
+        self.assertEqual(rows_of_projection(), incremental)
+
+    def test_no_outbox_row_when_command_rolls_back(self):
+        main.create_shipment("s1", "o1")
+        main.dispatch_shipment("s1", "bpost", date(2026, 3, 3))
+        with self.assertRaises(Exception):
+            main.dispatch_shipment("s1", "dhl", date(2026, 3, 4))
+        with connect() as conn:
+            self.assertEqual(conn.execute("SELECT count(*) FROM shipping_outbox").fetchone()[0], 2)
+
+    def test_failing_handler_retried_then_dead_lettered(self):
+        from src.shipping.adapters.relay import MAX_ATTEMPTS, publish_pending
+        main.create_shipment("s1", "o1")
+        with connect() as conn:
+            conn.execute("INSERT INTO shipping_outbox (event_type, payload) VALUES ('Boom', '{}')")
+        def boom(*a):
+            raise RuntimeError("x")
+        for _ in range(MAX_ATTEMPTS):
+            publish_pending({"Boom": [boom]})
+        with connect() as conn:
+            self.assertTrue(conn.execute("SELECT dead_lettered FROM shipping_outbox WHERE event_type = 'Boom'").fetchone()[0])
