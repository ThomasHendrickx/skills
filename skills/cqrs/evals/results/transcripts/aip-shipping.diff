diff -ruN -x __pycache__ -x '*.pyc' -x database.url base/src/projections/order_shipping.py repo/src/projections/order_shipping.py
--- base/src/projections/order_shipping.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/src/projections/order_shipping.py	2026-11-07 09:25:51.862788700 +0100
@@ -0,0 +1,47 @@
+"""Orders-side projection of shipment status, fed by Shipping's published events (table shipping_outbox).
+
+Idempotent: an event applies only if its version is newer than the stored one, so redelivery changes nothing.
+Run `python3 -m src.projections.order_shipping process` to apply pending events, `... rebuild` to rebuild from
+the full event history.
+"""
+import sys
+
+from src.db import connect
+
+APPLY = """
+INSERT INTO order_shipping_status (order_id, status, carrier, dispatched_on, shipment_version)
+VALUES (%s, %s, %s, %s, %s)
+ON CONFLICT (order_id) DO UPDATE
+SET status = EXCLUDED.status, carrier = EXCLUDED.carrier, dispatched_on = EXCLUDED.dispatched_on,
+    shipment_version = EXCLUDED.shipment_version
+WHERE order_shipping_status.shipment_version < EXCLUDED.shipment_version
+"""
+
+EVENTS = "SELECT id, order_id, status, carrier, dispatched_on, version FROM shipping_outbox {where} ORDER BY id"
+
+
+def process() -> int:
+    """Apply events not yet published. Each event is applied and marked in one transaction."""
+    done = 0
+    with connect() as conn:
+        for id_, order_id, status, carrier, on, version in conn.execute(EVENTS.format(where="WHERE published_at IS NULL")).fetchall():
+            with conn.transaction():
+                conn.execute(APPLY, (order_id, status, carrier, on, version))
+                conn.execute("UPDATE shipping_outbox SET published_at = now() WHERE id = %s", (id_,))
+            done += 1
+    return done
+
+
+def rebuild() -> int:
+    """Empty the projection and replay every event in order."""
+    with connect() as conn:
+        with conn.transaction():
+            conn.execute("DELETE FROM order_shipping_status")
+            for _, order_id, status, carrier, on, version in conn.execute(EVENTS.format(where="")).fetchall():
+                conn.execute(APPLY, (order_id, status, carrier, on, version))
+            conn.execute("UPDATE shipping_outbox SET published_at = coalesce(published_at, now())")
+    return 0
+
+
+if __name__ == "__main__":
+    {"process": process, "rebuild": rebuild}[sys.argv[1]]()
