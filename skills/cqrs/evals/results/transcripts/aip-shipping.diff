diff -ruN -x __pycache__ -x '*.pyc' -x database.url base/src/projections/order_shipping.py repo/src/projections/order_shipping.py
--- base/src/projections/order_shipping.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/src/projections/order_shipping.py	2026-11-07 17:17:17.206784512 +0100
@@ -0,0 +1,50 @@
+"""Projection order_shipping: shipping status per order, fed by ShipmentDispatched.v1 from the shipping outbox.
+
+Update trigger: async, the outbox relay (process). Staleness bound: one relay run; main.dispatch_shipment runs
+the relay right after commit, so the dispatch email (sent by a relay run) never precedes the projection.
+Idempotency key: event_id (order_shipping_processed, same transaction as the effect) plus shipment_version:
+an older version never overwrites a newer one.
+Read-your-own-writes: the relay is run after the commit that dispatches; the query reads only this table.
+Rebuild: python3 -m src.projections.order_shipping rebuild (replays the retained shipping_outbox).
+"""
+import sys
+
+from src.db import connect
+
+
+def handle(conn, event_id, type_, payload):
+    if type_ != "ShipmentDispatched.v1":
+        return
+    if conn.execute("INSERT INTO order_shipping_processed (event_id) VALUES (%s) ON CONFLICT DO NOTHING RETURNING 1", (event_id,)).fetchone() is None:
+        return
+    conn.execute(
+        "INSERT INTO order_shipping (order_id, status, carrier, dispatched_on, shipment_version) "
+        "VALUES (%(order_id)s, 'dispatched', %(carrier)s, %(dispatched_on)s, %(version)s) "
+        "ON CONFLICT (order_id) DO UPDATE SET status = excluded.status, carrier = excluded.carrier, "
+        "dispatched_on = excluded.dispatched_on, shipment_version = excluded.shipment_version "
+        "WHERE order_shipping.shipment_version < excluded.shipment_version", payload)
+
+
+def deliver(event_id, type_, payload):
+    with connect() as conn:
+        with conn.transaction():
+            handle(conn, event_id, type_, payload)
+
+
+def rebuild():
+    with connect() as conn:
+        with conn.transaction():
+            conn.execute("DELETE FROM order_shipping")
+            conn.execute("DELETE FROM order_shipping_processed")
+            for event_id, type_, payload in conn.execute("SELECT event_id, type, payload FROM shipping_outbox ORDER BY id").fetchall():
+                handle(conn, event_id, type_, payload)
+
+
+if __name__ == "__main__":
+    if sys.argv[1:] == ["rebuild"]:
+        rebuild()
+    elif sys.argv[1:] == ["process"]:
+        from src.shipping.adapters.relay import relay
+        print(relay(deliver))
+    else:
+        sys.exit("usage: python3 -m src.projections.order_shipping rebuild|process")
