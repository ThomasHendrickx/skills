--- base/tests/test_order_shipping_projection.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/tests/test_order_shipping_projection.py	2026-11-07 17:17:17.223784341 +0100
@@ -0,0 +1,64 @@
+from datetime import date
+
+from src import main
+from src.db import connect
+from src.projections import order_shipping
+from src.shipping.adapters.relay import relay
+from src.web.customer_pages import my_orders_page
+from tests.support import DbTest
+
+
+def rows():
+    with connect() as c:
+        return c.execute("SELECT order_id, status, carrier, dispatched_on, shipment_version FROM order_shipping ORDER BY order_id").fetchall()
+
+
+class ProjectionTest(DbTest):
+    def setUp(self):
+        super().setUp()
+        self.customer("ann")
+        self.order("o1", "ann")
+        main.create_shipment("s1", "o1")
+
+    def test_dispatch_updates_projection_and_page(self):
+        main.dispatch_shipment("s1", "bpost", date(2026, 3, 3))
+        self.assertEqual(rows(), [("o1", "dispatched", "bpost", date(2026, 3, 3), 2)])
+        self.assertEqual(my_orders_page("ann")["rows"][0]["shipping_status"], "dispatched")
+
+    def test_redelivery_applies_once(self):
+        main.dispatch_shipment("s1", "bpost", date(2026, 3, 3))
+        with connect() as c:
+            eid, t, p = c.execute("SELECT event_id, type, payload FROM shipping_outbox").fetchone()
+        order_shipping.deliver(eid, t, p)
+        order_shipping.deliver(eid, t, p)
+        self.assertEqual(len(rows()), 1)
+
+    def test_older_version_ignored(self):
+        main.dispatch_shipment("s1", "bpost", date(2026, 3, 3))
+        order_shipping.deliver("old", "ShipmentDispatched.v1", {"order_id": "o1", "version": 1, "carrier": "dhl", "dispatched_on": "2026-03-01"})
+        self.assertEqual(rows()[0][2], "bpost")
+
+    def test_rebuild_equals_incremental(self):
+        main.dispatch_shipment("s1", "bpost", date(2026, 3, 3))
+        before = rows()
+        order_shipping.rebuild()
+        self.assertEqual(rows(), before)
+
+    def test_rollback_writes_no_event(self):
+        try:
+            main.dispatch_shipment("s1", "bpost", date(2026, 3, 3))
+            main.dispatch_shipment("s1", "dhl", date(2026, 3, 4))
+        except Exception:
+            pass
+        with connect() as c:
+            self.assertEqual(c.execute("SELECT count(*) FROM shipping_outbox").fetchone()[0], 1)
+
+    def test_failing_consumer_retried_then_dead_lettered(self):
+        with connect() as c:
+            c.execute("INSERT INTO shipping_outbox (event_id, type, payload) VALUES ('x', 'T', '{}')")
+        def boom(*a):
+            raise RuntimeError
+        for _ in range(5):
+            relay(boom)
+        with connect() as c:
+            self.assertTrue(c.execute("SELECT dead_lettered FROM shipping_outbox WHERE event_id='x'").fetchone()[0])
