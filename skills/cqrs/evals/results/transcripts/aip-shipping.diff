diff -ruN -x __pycache__ -x '*.pyc' -x database.url base/tests/test_order_shipping_projection.py repo/tests/test_order_shipping_projection.py
--- base/tests/test_order_shipping_projection.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/tests/test_order_shipping_projection.py	2026-11-07 09:25:51.879788528 +0100
@@ -0,0 +1,51 @@
+from datetime import date
+
+from src import main
+from src.db import connect
+from src.projections import order_shipping
+from tests.support import DbTest
+
+
+def rows():
+    with connect() as conn:
+        return conn.execute("SELECT order_id, status, carrier, dispatched_on, shipment_version FROM order_shipping_status ORDER BY order_id").fetchall()
+
+
+class ShippingProjectionTest(DbTest):
+    def setUp(self):
+        super().setUp()
+        self.customer("ann")
+        self.order("o1", "ann")
+        self.order("o2", "ann")
+        main.create_shipment("s1", "o1")
+        main.create_shipment("s2", "o2")
+        main.dispatch_shipment("s1", "bpost", date(2026, 3, 3))
+
+    def test_changes_become_rows(self):
+        self.assertEqual(rows(), [("o1", "dispatched", "bpost", date(2026, 3, 3), 2), ("o2", "pending", None, None, 1)])
+
+    def test_event_applied_twice_changes_nothing(self):
+        before = rows()
+        with connect() as conn:
+            conn.execute("UPDATE shipping_outbox SET published_at = NULL")
+        order_shipping.process()
+        order_shipping.process()
+        self.assertEqual(rows(), before)
+
+    def test_stale_event_does_not_overwrite_newer(self):
+        with connect() as conn:
+            conn.execute("UPDATE shipping_outbox SET published_at = NULL WHERE version = 1")
+        order_shipping.process()
+        self.assertEqual(rows()[0][1], "dispatched")
+
+    def test_rebuild_equals_incremental(self):
+        before = rows()
+        order_shipping.rebuild()
+        self.assertEqual(rows(), before)
+
+    def test_pending_events_apply_on_process(self):
+        with connect() as conn:
+            conn.execute("DELETE FROM order_shipping_status")
+            conn.execute("UPDATE shipping_outbox SET published_at = NULL")
+        self.assertEqual(order_shipping.process(), 3)
+        self.assertEqual(len(rows()), 2)
