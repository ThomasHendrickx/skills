diff -ruN -x __pycache__ -x '*.pyc' -x database.url base/src/shipping/adapters/relay.py repo/src/shipping/adapters/relay.py
--- base/src/shipping/adapters/relay.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/src/shipping/adapters/relay.py	2026-11-07 18:02:51.292786899 +0100
@@ -0,0 +1,36 @@
+"""Relay: publishes shipping_outbox rows after commit, at least once, in outbox order. Retries, then dead-letters."""
+import logging
+
+from src.db import connect
+
+MAX_ATTEMPTS = 5
+log = logging.getLogger("shipping.relay")
+
+
+def publish_pending(handlers):
+    """handlers: {event_type: callable(event_id, payload, conn)}; each runs in the transaction that marks the row published.
+    Returns the number of rows published."""
+    published = 0
+    while True:
+        with connect() as conn:
+            row = conn.execute(
+                "SELECT id, event_type, payload FROM shipping_outbox WHERE published_at IS NULL AND NOT dead_lettered"
+                " ORDER BY id LIMIT 1 FOR UPDATE SKIP LOCKED").fetchone()
+            if row is None:
+                return published
+            event_id, event_type, payload = row
+            try:
+                with conn.transaction():
+                    for handler in handlers.get(event_type, []):
+                        handler(event_id, payload, conn)
+                    conn.execute("UPDATE shipping_outbox SET published_at = now() WHERE id = %s", (event_id,))
+                published += 1
+            except Exception:
+                attempts = conn.execute("UPDATE shipping_outbox SET attempts = attempts + 1 WHERE id = %s RETURNING attempts",
+                                        (event_id,)).fetchone()[0]
+                if attempts >= MAX_ATTEMPTS:
+                    conn.execute("UPDATE shipping_outbox SET dead_lettered = true WHERE id = %s", (event_id,))
+                    log.error("ALERT: shipping outbox event %s dead-lettered after %s attempts", event_id, attempts)
+                else:
+                    log.warning("shipping outbox event %s failed (attempt %s)", event_id, attempts)
+                    return published  # retry on the next run, keeping order
