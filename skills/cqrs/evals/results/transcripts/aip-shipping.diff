diff -ruN -x __pycache__ -x '*.pyc' -x database.url base/src/shipping/adapters/relay.py repo/src/shipping/adapters/relay.py
--- base/src/shipping/adapters/relay.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/src/shipping/adapters/relay.py	2026-11-07 17:17:17.205784522 +0100
@@ -0,0 +1,30 @@
+"""Relay: publishes shipping_outbox rows after commit, at least once. A failing delivery is retried on the
+next run; after MAX_ATTEMPTS the row is dead-lettered (dead_lettered = true) and an alert is logged."""
+import logging
+
+from src.db import connect
+
+MAX_ATTEMPTS = 5
+log = logging.getLogger("shipping.relay")
+
+
+def relay(deliver):
+    """Deliver each unpublished row to deliver(event_id, type, payload). Returns the number published."""
+    published = 0
+    with connect() as conn:
+        rows = conn.execute("SELECT id, event_id, type, payload FROM shipping_outbox "
+                            "WHERE published_at IS NULL AND NOT dead_lettered ORDER BY id").fetchall()
+    for row_id, event_id, type_, payload in rows:
+        try:
+            deliver(event_id, type_, payload)
+        except Exception:
+            with connect() as conn:
+                (attempts,) = conn.execute("UPDATE shipping_outbox SET attempts = attempts + 1 WHERE id = %s RETURNING attempts", (row_id,)).fetchone()
+                if attempts >= MAX_ATTEMPTS:
+                    conn.execute("UPDATE shipping_outbox SET dead_lettered = true WHERE id = %s", (row_id,))
+                    log.error("ALERT: shipping event %s dead-lettered", event_id, exc_info=True)
+            continue
+        with connect() as conn:
+            conn.execute("UPDATE shipping_outbox SET published_at = now() WHERE id = %s", (row_id,))
+        published += 1
+    return published
