@@ -0,0 +1,41 @@
+"""Orders-side projection of shipping status, built only from Shipping's published events.
+
+Trigger: outbox consumer. Idempotency key: the outbox event id (processed_shipping_events) plus the shipment version.
+Staleness bound: the relay runs right after each shipping command commits; otherwise the next process run (1 min).
+Read-your-own-writes: main.create_shipment/dispatch_shipment apply the projection before returning, so the dispatch
+(and the email that follows it) never precedes the row a customer reads.
+Rebuild: `python3 -m src.rebuild_projection` replays the whole outbox into an emptied projection.
+"""
+from src.shipping.adapters.relay import publish_pending
+
+
+def apply(event_id, payload, conn):
+    if conn.execute("INSERT INTO processed_shipping_events (event_id) VALUES (%s) ON CONFLICT DO NOTHING RETURNING 1",
+                    (event_id,)).fetchone() is None:
+        return  # redelivery: already applied
+    # Upsert guarded by version: an older event after a newer one is ignored.
+    conn.execute(
+        "INSERT INTO order_shipping_status (order_id, shipment_id, status, carrier, dispatched_on, version)"
+        " VALUES (%(order_id)s, %(shipment_id)s, %(status)s, %(carrier)s, %(on)s, %(version)s)"
+        " ON CONFLICT (order_id) DO UPDATE SET shipment_id = excluded.shipment_id, status = excluded.status,"
+        " carrier = excluded.carrier, dispatched_on = excluded.dispatched_on, version = excluded.version"
+        " WHERE order_shipping_status.version < excluded.version",
+        {"order_id": payload["order_id"], "shipment_id": payload["shipment_id"], "version": payload["version"],
+         "status": "dispatched" if "carrier" in payload else "pending",
+         "carrier": payload.get("carrier"), "on": payload.get("dispatched_on")})
+
+
+HANDLERS = {"ShipmentCreated": [apply], "ShipmentDispatched": [apply]}
+
+
+def process():
+    """Apply pending updates."""
+    return publish_pending(HANDLERS)
+
+
+def rebuild():
+    from src.db import connect
+    with connect() as conn:
+        conn.execute("TRUNCATE order_shipping_status, processed_shipping_events")
+        conn.execute("UPDATE shipping_outbox SET published_at = NULL, attempts = 0 WHERE NOT dead_lettered")
+    return process()
