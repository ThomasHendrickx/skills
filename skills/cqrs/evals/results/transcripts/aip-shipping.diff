@@ -0,0 +1,19 @@
+"""Shipping's published integration events (one producer: Shipping). Additive changes only; a breaking change is a new version.
+
+ShipmentCreated v1:    shipment_id, order_id, version
+ShipmentDispatched v1: shipment_id, order_id, version, carrier, dispatched_on (ISO date)
+`version` is the shipment's version after the change. The payload carries the dispatch facts because the
+Orders-side projection needs them (declared state transfer).
+"""
+CONTRACT_VERSION = 1
+
+
+def shipment_created(shipment):
+    return "ShipmentCreated", {"contract_version": CONTRACT_VERSION, "shipment_id": shipment.id,
+                               "order_id": shipment.order_id, "version": shipment.version}
+
+
+def shipment_dispatched(shipment):
+    return "ShipmentDispatched", {"contract_version": CONTRACT_VERSION, "shipment_id": shipment.id,
+                                  "order_id": shipment.order_id, "version": shipment.version,
+                                  "carrier": shipment.carrier, "dispatched_on": shipment.dispatched_on.isoformat()}
