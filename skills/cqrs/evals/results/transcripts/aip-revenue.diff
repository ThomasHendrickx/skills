+
+class MonthlyRevenueProjectionTest(DbTest):
+    def setUp(self):
+        super().setUp()
+        self.customer("ann")
+
+    def rows(self):
+        return [(r.month, r.revenue_cents, r.invoices) for r in monthly_revenue(date(2026, 11, 7))]
+
+    def test_report_sees_issue_and_void_immediately(self):
+        main.issue_invoice("i1", "ann", 1000, date(2026, 11, 1))
+        self.assertEqual(self.rows(), [(date(2026, 11, 1), 1000, 1)])
+        main.void_invoice("i1")
+        self.assertEqual(self.rows(), [])
+
+    def test_same_change_applied_twice_counts_once(self):
+        from src.adapters import pg_revenue_projection as p
+        from src.core.invoices import Invoice
+        from src.db import connect
+        inv = Invoice("i1", "ann", 1000, date(2026, 11, 1))
+        main.issue_invoice("i1", "ann", 1000, date(2026, 11, 1))
+        with connect() as c:
+            p.apply_issued(c, inv)
+            inv.voided = True
+            p.apply_voided(c, inv)
+            p.apply_voided(c, inv)
+        with connect() as c:
+            c.execute("UPDATE invoices SET voided = true WHERE id = 'i1'")
+        self.assertEqual(self.rows(), [])
+
+    def test_rolled_back_change_leaves_projection_alone(self):
+        with self.assertRaises(Exception):
+            main.issue_invoice("i1", "nobody", 1000, date(2026, 11, 1))
+        self.assertEqual(self.rows(), [])
+
+    def test_rebuild_equals_incremental(self):
+        from src.adapters import pg_revenue_projection as p
+        from src.db import connect
+        main.issue_invoice("i1", "ann", 1000, date(2026, 10, 3))
+        main.issue_invoice("i2", "ann", 500, date(2026, 10, 20))
+        main.issue_invoice("i3", "ann", 700, date(2026, 11, 1))
+        main.issue_invoice("i4", "ann", 900, date(2026, 9, 2))
+        main.void_invoice("i4")
+        main.void_invoice("i2")
+        incremental = self.rows()
+        with connect() as c:
+            c.execute("DELETE FROM monthly_revenue_projection")
+            p.rebuild(c)
+        self.assertEqual(self.rows(), incremental)
