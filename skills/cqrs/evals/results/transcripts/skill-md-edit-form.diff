diff -ruN -x __pycache__ -x '*.pyc' -x database.url base/src/queries/order_edit_form.py repo/src/queries/order_edit_form.py
--- base/src/queries/order_edit_form.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/src/queries/order_edit_form.py	2026-11-07 09:25:17.283138622 +0100
@@ -0,0 +1,29 @@
+"""Query: the staff order edit form. Reads the tables directly; no domain imports."""
+from dataclasses import dataclass
+
+from src.db import connect
+
+
+class OrderEditFormNotFound(Exception):
+    pass
+
+
+@dataclass(frozen=True)
+class OrderEditForm:
+    number: str
+    status: str
+    street: str
+    city: str
+    postcode: str
+    note: str
+    customer_email: str
+
+
+def order_edit_form(order_id):
+    with connect() as conn:
+        row = conn.execute(
+            "SELECT o.number, o.status, o.shipping_street, o.shipping_city, o.shipping_postcode, o.note, c.email"
+            " FROM orders o JOIN customers c ON c.id = o.customer_id WHERE o.id = %s", (order_id,)).fetchone()
+    if row is None:
+        raise OrderEditFormNotFound(order_id)
+    return OrderEditForm(*row)
