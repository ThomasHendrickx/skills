+
+class MonthlyRevenueProjectionTest(DbTest):
+    def setUp(self):
+        super().setUp()
+        self.customer("ann")
+
+    def rows(self):
+        return [(r.month, r.revenue_cents, r.invoices) for r in monthly_revenue(date(2026, 11, 7))]
+
+    def test_issue_and_void_visible_immediately(self):
+        main.issue_invoice("i1", "ann", 1000, date(2026, 11, 3))
+        self.assertEqual(self.rows(), [(date(2026, 11, 1), 1000, 1)])
+        main.void_invoice("i1")
+        self.assertEqual(self.rows(), [])
+
+    def test_same_change_applied_twice_counts_once(self):
+        from src.adapters import revenue_projection
+        from src.core.invoices import Invoice
+        from src.db import connect
+        inv = Invoice("i1", "ann", 1000, date(2026, 11, 3))
+        main.issue_invoice("i1", "ann", 1000, date(2026, 11, 3))
+        with connect() as conn:
+            revenue_projection.on_issued(conn, inv)
+            inv.voided = True
+            revenue_projection.on_voided(conn, inv)
+            revenue_projection.on_voided(conn, inv)
+        self.assertEqual(self.rows(), [])
+
+    def test_rebuild_equals_incremental(self):
+        from src.adapters import revenue_projection
+        from src.db import connect
+        main.issue_invoice("i1", "ann", 1000, date(2026, 10, 3))
+        main.issue_invoice("i2", "ann", 500, date(2026, 11, 3))
+        main.issue_invoice("i3", "ann", 900, date(2026, 11, 4))
+        main.void_invoice("i3")
+        before = self.rows()
+        revenue_projection.rebuild()
+        self.assertEqual(self.rows(), before)
+        main.void_invoice("i2")
+        self.assertEqual(self.rows(), [(date(2026, 10, 1), 1000, 1)])
