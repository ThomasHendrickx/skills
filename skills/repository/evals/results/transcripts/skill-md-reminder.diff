@@ -0,0 +1,17 @@
+from src.core.ports.orders import PageRequest
+
+PAGE_SIZE = 100
+
+
+def send_reminders(orders, notifier, today):
+    by_customer = {}
+    offset = 0
+    while True:
+        page = orders.find_overdue(today, PageRequest(PAGE_SIZE, offset))
+        for order in page:
+            by_customer.setdefault(order.customer_id, []).append(order.number)
+        if len(page) < PAGE_SIZE:
+            break
+        offset += PAGE_SIZE
+    for customer_id, numbers in by_customer.items():
+        notifier.send(customer_id, "Overdue orders", "\n".join(numbers))
