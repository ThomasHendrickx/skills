@@ -0,0 +1,23 @@
+import unittest
+from datetime import date
+
+from src.adapters.memory_orders import InMemoryOrders
+from src.adapters.recording_notifier import RecordingNotifier
+from src.core.orders import Order
+from src.core.reminders import send_reminders
+
+
+class SendRemindersTest(unittest.TestCase):
+    def test_one_mail_per_customer_listing_overdue_unpaid(self):
+        repo, notifier = InMemoryOrders(), RecordingNotifier()
+        d = date(2026, 1, 1)
+        repo.save(Order("1", "N-1", "c1", d))
+        repo.save(Order("2", "N-2", "c1", d))
+        repo.save(Order("3", "N-3", "c2", d, "paid"))
+        repo.save(Order("4", "N-4", "c3", date(2026, 2, 1)))
+        send_reminders(repo, notifier, date(2026, 1, 10))
+        self.assertEqual([("c1", "Overdue orders", "N-1\nN-2")], notifier.sent)
+
+
+if __name__ == "__main__":
+    unittest.main()
