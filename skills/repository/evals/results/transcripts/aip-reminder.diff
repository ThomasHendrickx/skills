--- base/tests/test_reminders.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/tests/test_reminders.py	2026-11-06 17:27:29.885402739 +0100
@@ -0,0 +1,34 @@
+import unittest
+from datetime import date
+
+from src.adapters.memory_orders import InMemoryOrders
+from src.adapters.recording_notifier import RecordingNotifier
+from src.core import reminders
+from src.core.orders import Order
+
+
+class RemindersTest(unittest.TestCase):
+    def run_it(self, page_size=100):
+        reminders.PAGE_SIZE = page_size
+        repo, notifier = InMemoryOrders(), RecordingNotifier()
+        for i, (cust, due, status) in enumerate([
+            ("c1", date(2026, 2, 1), "placed"), ("c1", date(2026, 2, 2), "placed"),
+            ("c1", date(2026, 2, 3), "paid"), ("c2", date(2026, 2, 1), "placed"),
+            ("c3", date(2026, 3, 5), "placed"), ("c4", date(2026, 2, 1), "paid"),
+        ]):
+            repo.save(Order(f"o{i}", f"N-{i}", cust, due, status))
+        reminders.send_reminders(repo, notifier, date(2026, 3, 1))
+        return notifier.sent
+
+    def test_one_mail_per_customer_with_overdue(self):
+        self.assertEqual(
+            [("c1", "Overdue orders", "N-0\nN-1"), ("c2", "Overdue orders", "N-3")], self.run_it())
+
+    def test_same_result_when_customer_spans_pages(self):
+        for size in (1, 2, 3):
+            self.assertEqual(self.run_it(100), self.run_it(size))
+        reminders.PAGE_SIZE = 100
+
+
+if __name__ == "__main__":
+    unittest.main()
