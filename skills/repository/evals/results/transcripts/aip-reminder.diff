@@ -0,0 +1,24 @@
+from itertools import groupby
+
+from src.core.orders import PageRequest
+
+PAGE_SIZE = 100
+
+
+def send_reminders(orders, notifier, today):
+    """Mail each customer one list of their overdue unpaid orders; reads pages until exhausted."""
+    offset = 0
+    pending = []  # orders of the customer that may continue on the next page
+    while True:
+        page = orders.list_overdue_unpaid(today, PageRequest(PAGE_SIZE, offset))
+        offset += len(page)
+        batch = pending + page
+        pending = []
+        groups = [(c, list(g)) for c, g in groupby(batch, key=lambda o: o.customer_id)]
+        if len(page) == PAGE_SIZE and groups:
+            pending = groups.pop()[1]  # last customer may span into the next page
+        for customer_id, found in groups:
+            body = "\n".join(o.number for o in found)
+            notifier.send(customer_id, "Overdue orders", body)
+        if len(page) < PAGE_SIZE:
+            return
