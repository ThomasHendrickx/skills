+"""Display read model for the finance dashboard. Not a repository: it reads, never loads aggregates."""
+import sqlite3
+
+
+def customer_totals(conn: sqlite3.Connection):
+    """One row per customer (customer_id, order_count, total_cents), biggest total first; drafts excluded."""
+    return conn.execute(
+        "SELECT customer_id, COUNT(*) AS order_count, SUM(total_cents) AS total_cents "
+        "FROM orders WHERE status != 'draft' GROUP BY customer_id "
+        "ORDER BY total_cents DESC, customer_id"
+    ).fetchall()
