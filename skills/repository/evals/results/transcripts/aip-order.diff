@@ -0,0 +1,59 @@
+import sqlite3
+from datetime import date
+
+from src.core.orders import DuplicateOrderNumber, Line, Order
+from src.core.ports.order_repository import OrderRepository
+
+
+class SqliteOrderRepository(OrderRepository):
+    """Uses the connection of the surrounding unit of work; never commits."""
+
+    def __init__(self, connection):
+        self._conn = connection
+
+    def get(self, order_id):
+        row = self._conn.execute(
+            "SELECT id, number, customer_id, due, status FROM orders WHERE id = ?", (order_id,)
+        ).fetchone()
+        return self._load(row) if row else None
+
+    def save(self, order):
+        taken = self._conn.execute(
+            "SELECT 1 FROM orders WHERE number = ? AND id != ?", (order.number, order.id)
+        ).fetchone()
+        if taken:
+            raise DuplicateOrderNumber(order.number)
+        try:
+            self._conn.execute(
+                "INSERT INTO orders (id, number, customer_id, due, status, total_cents) VALUES (?, ?, ?, ?, ?, ?) "
+                "ON CONFLICT(id) DO UPDATE SET number=excluded.number, customer_id=excluded.customer_id, "
+                "due=excluded.due, status=excluded.status, total_cents=excluded.total_cents",
+                (order.id, order.number, order.customer_id, order.due.isoformat(), order.status, order.total_cents),
+            )
+        except sqlite3.IntegrityError as error:
+            raise DuplicateOrderNumber(order.number) from error
+        self._conn.execute("DELETE FROM order_lines WHERE order_id = ?", (order.id,))
+        for position, line in enumerate(order.lines):
+            self._conn.execute(
+                "INSERT INTO order_lines (order_id, position, sku, quantity, unit_cents) VALUES (?, ?, ?, ?, ?)",
+                (order.id, position, line.sku, line.quantity, line.unit_cents),
+            )
+
+    def list_for_customer_by_due_desc(self, customer_id, page):
+        rows = self._conn.execute(
+            "SELECT id, number, customer_id, due, status FROM orders WHERE customer_id = ? "
+            "ORDER BY due DESC, number ASC LIMIT ? OFFSET ?",
+            (customer_id, page.limit, page.offset),
+        ).fetchall()
+        return [self._load(row) for row in rows]
+
+    def _load(self, row):
+        order_id, number, customer_id, due, status = row
+        lines = [
+            Line(sku, quantity, unit_cents)
+            for sku, quantity, unit_cents in self._conn.execute(
+                "SELECT sku, quantity, unit_cents FROM order_lines WHERE order_id = ? ORDER BY position",
+                (order_id,),
+            )
+        ]
+        return Order(order_id, number, customer_id, date.fromisoformat(due), lines, status)
