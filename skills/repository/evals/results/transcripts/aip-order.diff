diff -ruN -x __pycache__ -x '*.pyc' base/src/core/ports/order_repository.py repo/src/core/ports/order_repository.py
--- base/src/core/ports/order_repository.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/src/core/ports/order_repository.py	2026-11-06 17:27:31.839382948 +0100
@@ -0,0 +1,24 @@
+from abc import ABC, abstractmethod
+from typing import Optional
+
+from src.core.orders import Order, PageRequest
+
+
+class OrderRepository(ABC):
+    """Repository for the Order aggregate root; lines load and save with their order.
+
+    Never commits: the use case's unit of work owns the transaction.
+    """
+
+    @abstractmethod
+    def get(self, order_id: str) -> Optional[Order]:
+        """The order with all its lines, or None when the id is unknown."""
+
+    @abstractmethod
+    def save(self, order: Order) -> None:
+        """Save the whole aggregate (order and lines). Raises DuplicateOrderNumber
+        when another order already has the number."""
+
+    @abstractmethod
+    def list_for_customer_by_due_desc(self, customer_id: str, page: PageRequest) -> list:
+        """A customer's orders, latest due date first (ties by number), one page."""
diff -ruN -x __pycache__ -x '*.pyc' base/tests/test_order_repository_contract.py repo/tests/test_order_repository_contract.py
--- base/tests/test_order_repository_contract.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/tests/test_order_repository_contract.py	2026-11-06 17:27:31.843382907 +0100
@@ -0,0 +1,71 @@
+import unittest
+from datetime import date
+
+from src.adapters.memory_order_repository import InMemoryOrderRepository
+from src.adapters.schema import connect
+from src.adapters.sqlite_order_repository import SqliteOrderRepository
+from src.core.orders import DuplicateOrderNumber, Line, Order, PageRequest
+
+
+def order(id, number, customer="c1", due=date(2026, 1, 10), lines=None):
+    return Order(id, number, customer, due, lines if lines is not None else [Line("tea", 2, 300), Line("mug", 1, 900)])
+
+
+class OrderRepositoryContract:
+    def make_repo(self):
+        raise NotImplementedError
+
+    def setUp(self):
+        self.repo = self.make_repo()
+
+    def test_round_trip_with_lines_and_total(self):
+        self.repo.save(order("1", "N-1"))
+        got = self.repo.get("1")
+        self.assertEqual([Line("tea", 2, 300), Line("mug", 1, 900)], got.lines)
+        self.assertEqual(1500, got.total_cents)
+        self.assertEqual(date(2026, 1, 10), got.due)
+
+    def test_not_found_is_none(self):
+        self.assertIsNone(self.repo.get("missing"))
+
+    def test_duplicate_number_fails(self):
+        self.repo.save(order("1", "N-1"))
+        with self.assertRaises(DuplicateOrderNumber):
+            self.repo.save(order("2", "N-1"))
+        self.assertIsNone(self.repo.get("2"))
+
+    def test_resave_replaces_lines(self):
+        self.repo.save(order("1", "N-1"))
+        self.repo.save(order("1", "N-1", lines=[Line("pot", 1, 500)]))
+        self.assertEqual([Line("pot", 1, 500)], self.repo.get("1").lines)
+        self.assertEqual(500, self.repo.get("1").total_cents)
+
+    def test_list_latest_due_first_for_customer_only(self):
+        self.repo.save(order("1", "N-1", due=date(2026, 1, 1)))
+        self.repo.save(order("2", "N-2", due=date(2026, 3, 1)))
+        self.repo.save(order("3", "N-3", due=date(2026, 2, 1)))
+        self.repo.save(order("4", "N-4", customer="c2", due=date(2026, 9, 1)))
+        got = self.repo.list_for_customer_by_due_desc("c1", PageRequest(10, 0))
+        self.assertEqual(["2", "3", "1"], [o.id for o in got])
+
+    def test_list_is_paged(self):
+        for i in range(5):
+            self.repo.save(order(str(i), f"N-{i}", due=date(2026, 1, 1 + i)))
+        first = self.repo.list_for_customer_by_due_desc("c1", PageRequest(2, 0))
+        second = self.repo.list_for_customer_by_due_desc("c1", PageRequest(2, 2))
+        self.assertEqual(["4", "3"], [o.id for o in first])
+        self.assertEqual(["2", "1"], [o.id for o in second])
+
+
+class InMemoryContract(OrderRepositoryContract, unittest.TestCase):
+    def make_repo(self):
+        return InMemoryOrderRepository()
+
+
+class SqliteContract(OrderRepositoryContract, unittest.TestCase):
+    def make_repo(self):
+        return SqliteOrderRepository(connect())
+
+
+if __name__ == "__main__":
+    unittest.main()
