@@ -0,0 +1,24 @@
+import copy
+
+from src.core.orders import DuplicateOrderNumber
+from src.core.ports.order_repository import OrderRepository
+
+
+class InMemoryOrderRepository(OrderRepository):
+    def __init__(self):
+        self._orders = {}
+
+    def get(self, order_id):
+        order = self._orders.get(order_id)
+        return copy.deepcopy(order) if order else None
+
+    def save(self, order):
+        if any(o.number == order.number and o.id != order.id for o in self._orders.values()):
+            raise DuplicateOrderNumber(order.number)
+        self._orders[order.id] = copy.deepcopy(order)
+
+    def list_for_customer_by_due_desc(self, customer_id, page):
+        mine = [o for o in self._orders.values() if o.customer_id == customer_id]
+        mine.sort(key=lambda o: o.number)
+        mine.sort(key=lambda o: o.due, reverse=True)
+        return [copy.deepcopy(o) for o in mine[page.offset:page.offset + page.limit]]
