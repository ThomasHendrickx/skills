+++ repo/src/adapters/customer_totals.py	2026-11-06 17:27:13.224571489 +0100
@@ -0,0 +1,9 @@
+"""Read model for the finance dashboard: bypasses the Orders repository (display read, not a command)."""
+
+
+def customer_totals(conn):
+    """One row per customer: (customer_id, order_count, total_cents), biggest total first. Drafts excluded."""
+    return conn.execute(
+        "SELECT customer_id, COUNT(*), SUM(total_cents) FROM orders WHERE status <> 'draft' "
+        "GROUP BY customer_id ORDER BY SUM(total_cents) DESC, customer_id"
+    ).fetchall()
