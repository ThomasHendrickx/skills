@@ -0,0 +1,18 @@
+import unittest
+from datetime import date
+
+from src.adapters import schema
+from src.adapters.customer_totals import customer_totals
+from src.adapters.sqlite_orders import SqliteOrders
+from src.core.orders import Line, Order
+
+
+class CustomerTotalsTest(unittest.TestCase):
+    def test_totals_exclude_drafts_and_sort_desc(self):
+        repo = SqliteOrders(schema.connect())
+        d = date(2026, 1, 1)
+        repo.save(Order("o1", "N-1", "c1", d, "placed", [Line("a", 1, 100)]))
+        repo.save(Order("o2", "N-2", "c2", d, "placed", [Line("a", 1, 500)]))
+        repo.save(Order("o3", "N-3", "c2", d, "paid", [Line("a", 1, 200)]))
+        repo.save(Order("o4", "N-4", "c1", d, "draft", [Line("a", 1, 9999)]))
+        self.assertEqual([("c2", 2, 700), ("c1", 1, 100)], customer_totals(repo.conn))
