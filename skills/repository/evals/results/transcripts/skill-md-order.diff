diff -ruN -x __pycache__ -x '*.pyc' base/tests/order_repository_contract.py repo/tests/order_repository_contract.py
--- base/tests/order_repository_contract.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/tests/order_repository_contract.py	2026-11-06 17:27:24.338458921 +0100
@@ -0,0 +1,49 @@
+from datetime import date
+
+from src.core.orders import Line, Order
+from src.core.place_order import place_order
+from src.core.ports.order_repository import DuplicateOrderNumber, OrderNotFound, PageRequest
+
+
+def make(number, customer="c1", due=date(2026, 1, 10), lines=(("tea", 2, 300), ("mug", 1, 900))):
+    return Order(f"id-{number}", number, customer, due, [Line(*l) for l in lines])
+
+
+class OrderRepositoryContract:
+    """Mixin; subclasses set self.uow and self.orders in setUp."""
+
+    def test_round_trip_keeps_lines_and_total(self):
+        self.orders.save(make("N-1"))
+        got = self.orders.get("id-N-1")
+        self.assertEqual(
+            (1500, [("tea", 2, 300), ("mug", 1, 900)]),
+            (got.total_cents, [(l.sku, l.quantity, l.unit_cents) for l in got.lines]),
+        )
+
+    def test_save_replaces_lines(self):
+        order = make("N-1")
+        self.orders.save(order)
+        order.lines = [Line("pot", 1, 100)]
+        self.orders.save(order)
+        self.assertEqual(100, self.orders.get("id-N-1").total_cents)
+
+    def test_duplicate_number_fails(self):
+        self.orders.save(make("N-1"))
+        with self.assertRaises(DuplicateOrderNumber):
+            self.orders.save(Order("other", "N-1", "c2", date(2026, 2, 1), []))
+
+    def test_unknown_id_is_not_found(self):
+        with self.assertRaises(OrderNotFound):
+            self.orders.get("nope")
+
+    def test_customer_orders_latest_due_first_and_paged(self):
+        for n, d in (("N-1", 5), ("N-2", 20), ("N-3", 12)):
+            self.orders.save(make(n, due=date(2026, 1, d)))
+        self.orders.save(make("N-4", customer="c2", due=date(2026, 1, 30)))
+        first = self.orders.find_by_customer_latest_due_first("c1", PageRequest(2))
+        second = self.orders.find_by_customer_latest_due_first("c1", PageRequest(2, 2))
+        self.assertEqual((["N-2", "N-3"], ["N-1"]), ([o.number for o in first], [o.number for o in second]))
+
+    def test_place_order_saves_whole_order(self):
+        order_id = place_order(self.uow, self.orders, "N-9", "c1", date(2026, 1, 10), [("tea", 2, 300)])
+        self.assertEqual(600, self.orders.get(order_id).total_cents)
