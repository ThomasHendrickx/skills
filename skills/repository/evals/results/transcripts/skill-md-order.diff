@@ -0,0 +1,31 @@
+import copy
+
+from src.core.ports.order_repository import DuplicateOrderNumber, OrderNotFound
+
+
+class InMemoryUnitOfWork:
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        return False
+
+
+class InMemoryOrderRepository:
+    def __init__(self):
+        self._orders = {}
+
+    def get(self, order_id):
+        if order_id not in self._orders:
+            raise OrderNotFound(order_id)
+        return copy.deepcopy(self._orders[order_id])
+
+    def save(self, order):
+        if any(o.number == order.number and o.id != order.id for o in self._orders.values()):
+            raise DuplicateOrderNumber(order.number)
+        self._orders[order.id] = copy.deepcopy(order)
+
+    def find_by_customer_latest_due_first(self, customer_id, page):
+        mine = [o for o in self._orders.values() if o.customer_id == customer_id]
+        mine.sort(key=lambda o: (o.due, o.number), reverse=True)
+        return copy.deepcopy(mine[page.offset:page.offset + page.limit])
