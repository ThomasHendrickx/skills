@@ -0,0 +1,52 @@
+import sqlite3
+from datetime import date
+
+from src.core.orders import Line, Order
+from src.core.ports.order_repository import DuplicateOrderNumber, OrderNotFound
+
+
+class SqliteOrderRepository:
+    """Uses the unit of work's connection; never commits."""
+
+    def __init__(self, connection):
+        self._conn = connection
+
+    def get(self, order_id):
+        row = self._conn.execute(
+            "SELECT id, number, customer_id, due FROM orders WHERE id = ?", (order_id,)
+        ).fetchone()
+        if row is None:
+            raise OrderNotFound(order_id)
+        return self._load(row)
+
+    def save(self, order):
+        try:
+            self._conn.execute(
+                "INSERT INTO orders (id, number, customer_id, due, status, total_cents) "
+                "VALUES (?, ?, ?, ?, 'placed', ?) "
+                "ON CONFLICT(id) DO UPDATE SET number = excluded.number, customer_id = excluded.customer_id, "
+                "due = excluded.due, total_cents = excluded.total_cents",
+                (order.id, order.number, order.customer_id, order.due.isoformat(), order.total_cents),
+            )
+        except sqlite3.IntegrityError as error:
+            raise DuplicateOrderNumber(order.number) from error
+        self._conn.execute("DELETE FROM order_lines WHERE order_id = ?", (order.id,))
+        for position, line in enumerate(order.lines):
+            self._conn.execute(
+                "INSERT INTO order_lines (order_id, position, sku, quantity, unit_cents) VALUES (?, ?, ?, ?, ?)",
+                (order.id, position, line.sku, line.quantity, line.unit_cents),
+            )
+
+    def find_by_customer_latest_due_first(self, customer_id, page):
+        rows = self._conn.execute(
+            "SELECT id, number, customer_id, due FROM orders WHERE customer_id = ? "
+            "ORDER BY due DESC, number DESC LIMIT ? OFFSET ?",
+            (customer_id, page.limit, page.offset),
+        ).fetchall()
+        return [self._load(row) for row in rows]
+
+    def _load(self, row):
+        lines = self._conn.execute(
+            "SELECT sku, quantity, unit_cents FROM order_lines WHERE order_id = ? ORDER BY position", (row[0],)
+        ).fetchall()
+        return Order(row[0], row[1], row[2], date.fromisoformat(row[3]), [Line(*l) for l in lines])
