+import unittest
+
+from src.adapters.in_memory_orders import InMemoryOrderRepository, InMemoryUnitOfWork
+from src.adapters.sqlite_orders import SqliteOrderRepository
+from src.adapters.unit_of_work import SqliteUnitOfWork
+from tests.order_repository_contract import OrderRepositoryContract
+
+
+class InMemoryOrderRepositoryTest(OrderRepositoryContract, unittest.TestCase):
+    def setUp(self):
+        self.uow = InMemoryUnitOfWork()
+        self.orders = InMemoryOrderRepository()
+
+
+class SqliteOrderRepositoryTest(OrderRepositoryContract, unittest.TestCase):
+    def setUp(self):
+        self.uow = SqliteUnitOfWork()
+        self.orders = SqliteOrderRepository(self.uow.connection)
+
+
+if __name__ == "__main__":
+    unittest.main()
