+++ repo/src/core/ports/order_repository.py	2026-11-06 17:27:24.332458982 +0100
@@ -0,0 +1,29 @@
+from dataclasses import dataclass
+from typing import Optional, Protocol
+
+from src.core.orders import Order
+
+
+class DuplicateOrderNumber(Exception):
+    pass
+
+
+class OrderNotFound(Exception):
+    pass
+
+
+@dataclass(frozen=True)
+class PageRequest:
+    limit: int
+    offset: int = 0
+
+
+class OrderRepository(Protocol):
+    def get(self, order_id: str) -> Order:
+        """The whole order with its lines. Raises OrderNotFound."""
+
+    def save(self, order: Order) -> None:
+        """Save the whole aggregate. Raises DuplicateOrderNumber. Never commits."""
+
+    def find_by_customer_latest_due_first(self, customer_id: str, page: PageRequest) -> list:
+        """A customer's orders, most recent due date first, one page."""
