+"""Integration event: an invoice was paid. Published by Sales, consumed by Shipping.
+
+Version 1, topic sales.invoice-paid. Fields: invoice_id, order_id, paid_on (ISO date). Carries ids and the fact
+of the change only; no state transfer. Changes are additive; a breaking change is a new version."""
+TOPIC = "sales.invoice-paid"
+VERSION = 1
+
+
+def invoice_paid_v1(invoice_id: str, order_id: str, paid_on: str) -> dict:
+    return {"invoice_id": invoice_id, "order_id": order_id, "paid_on": paid_on}
