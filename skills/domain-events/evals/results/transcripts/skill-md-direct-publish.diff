--- base/src/sales/adapters/relay.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/src/sales/adapters/relay.py	2026-11-07 17:16:14.421415626 +0100
@@ -0,0 +1,16 @@
+"""Outbox relay: publishes committed sales events to the bus, at least once (a crash between publish and mark re-publishes)."""
+from src.db import connect
+from src.infra import bus
+
+
+def run_once() -> int:
+    """Publish every unpublished outbox row in order; return how many were published."""
+    count = 0
+    with connect() as conn:
+        rows = conn.execute("SELECT id, topic, body FROM sales_outbox WHERE published_at IS NULL ORDER BY id").fetchall()
+        for row_id, topic, body in rows:
+            bus.publish(topic, body)
+            conn.execute("UPDATE sales_outbox SET published_at = now() WHERE id = %s", (row_id,))
+            conn.commit()
+            count += 1
+    return count
