+class PayInvoiceOutboxTest(DbTest):
+    def messages(self):
+        return self.rows("SELECT body FROM bus_messages WHERE topic = 'sales.invoice-paid'")
+
+    def test_paying_writes_one_outbox_row_and_publishes_nothing_yet(self):
+        self.invoice()
+        main.pay_invoice("i1", date(2026, 11, 2))
+        self.assertEqual(self.rows("SELECT topic FROM sales_outbox"), [("sales.invoice-paid",)])
+        self.assertEqual(self.messages(), [])
+
+    def test_a_failed_save_leaves_no_outbox_row_and_no_message(self):
+        from src.sales.adapters.pg import StaleInvoice
+        from src.sales.adapters.pg import PgSalesUnitOfWork
+        self.invoice()
+        uow = PgSalesUnitOfWork()
+        with self.assertRaises(StaleInvoice):
+            with uow:
+                invoice = uow.invoices.get("i1")
+                self.rows("UPDATE invoices SET version = 5 WHERE id = 'i1' RETURNING id")
+                invoice.pay(date(2026, 11, 2))
+                uow.invoices.save(invoice)
+        from src.sales.adapters import relay
+        relay.run_once()
+        self.assertEqual(self.rows("SELECT * FROM sales_outbox"), [])
+        self.assertEqual(self.messages(), [])
+
+    def test_relay_publishes_once_after_commit(self):
+        from src.sales.adapters import relay
+        self.invoice()
+        main.pay_invoice("i1", date(2026, 11, 2))
+        self.assertEqual(relay.run_once(), 1)
+        self.assertEqual(relay.run_once(), 0)
+        self.assertEqual(len(self.messages()), 1)
