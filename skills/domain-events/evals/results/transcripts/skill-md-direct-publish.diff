diff -ruN -x __pycache__ -x '*.pyc' -x database.url base/src/sales/adapters/relay.py repo/src/sales/adapters/relay.py
--- base/src/sales/adapters/relay.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/src/sales/adapters/relay.py	2026-11-07 18:02:31.700985780 +0100
@@ -0,0 +1,27 @@
+"""Outbox relay: publishes committed Sales events to the bus, at least once (a crash between publish and
+marking republishes). Consumers must tolerate duplicates. Run it repeatedly (poll) after commit."""
+from src.contracts import invoice_paid
+from src.db import connect
+from src.infra import bus
+
+
+def _to_contract(event_type: str, payload: dict):
+    """Map an internal event to its integration contract; None when no contract (internal only)."""
+    if event_type == "InvoicePaid":
+        return invoice_paid.TOPIC, invoice_paid.invoice_paid_v1(payload["invoice_id"], payload["order_id"], payload["paid_on"])
+    return None
+
+
+def run_once() -> int:
+    """Publish every unpublished outbox row, oldest first; return how many rows were handled."""
+    handled = 0
+    with connect() as conn:
+        rows = conn.execute("SELECT id, event_type, payload FROM outbox WHERE published_at IS NULL ORDER BY id"
+                            " FOR UPDATE SKIP LOCKED").fetchall()
+        for row_id, event_type, payload in rows:
+            mapped = _to_contract(event_type, payload)
+            if mapped is not None:
+                bus.publish(*mapped)
+            conn.execute("UPDATE outbox SET published_at = now() WHERE id = %s", (row_id,))
+            handled += 1
+    return handled
