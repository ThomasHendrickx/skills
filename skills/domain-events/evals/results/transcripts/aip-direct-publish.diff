diff -ruN -x __pycache__ -x '*.pyc' -x database.url base/src/sales/adapters/relay.py repo/src/sales/adapters/relay.py
--- base/src/sales/adapters/relay.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/src/sales/adapters/relay.py	2026-11-07 17:16:29.822260817 +0100
@@ -0,0 +1,20 @@
+"""Outbox relay: publishes sales_outbox rows to the bus after commit, at least once.
+A row is marked published only after the bus accepted it, so a crash in between re-sends it (consumers dedupe)."""
+from src.db import connect
+from src.infra import bus
+
+TOPICS = {"InvoicePaid": "sales.invoice-paid"}
+
+
+def run_once() -> int:
+    """Publish every unpublished row, oldest first; return how many were published."""
+    published = 0
+    with connect(autocommit=True) as conn:
+        rows = conn.execute("SELECT id, event_type, payload FROM sales_outbox WHERE published_at IS NULL ORDER BY id").fetchall()
+        for row_id, event_type, payload in rows:
+            if event_type not in TOPICS:
+                continue
+            bus.publish(TOPICS[event_type], payload)
+            conn.execute("UPDATE sales_outbox SET published_at = now() WHERE id = %s", (row_id,))
+            published += 1
+    return published
