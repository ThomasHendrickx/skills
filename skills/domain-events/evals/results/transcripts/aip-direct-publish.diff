diff -ruN -x __pycache__ -x '*.pyc' -x database.url base/src/sales/adapters/relay.py repo/src/sales/adapters/relay.py
--- base/src/sales/adapters/relay.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/src/sales/adapters/relay.py	2026-11-07 18:02:40.393897536 +0100
@@ -0,0 +1,20 @@
+"""Outbox relay: publishes committed sales events to the bus, at least once (a crash between publish
+and marking leaves the row for the next run). Run it on a schedule or loop."""
+from src.db import connect
+from src.infra import bus
+
+TOPICS = {"InvoicePaid": "sales.invoice-paid"}
+
+
+def run_once(limit: int = 100) -> int:
+    """Publish unpublished outbox rows in order; return how many were published."""
+    published = 0
+    with connect() as conn:
+        rows = conn.execute("SELECT id, event_type, payload FROM sales_outbox WHERE published_at IS NULL"
+                            " AND event_type = ANY(%s) ORDER BY id LIMIT %s FOR UPDATE SKIP LOCKED",
+                            (list(TOPICS), limit)).fetchall()
+        for row_id, event_type, payload in rows:
+            bus.publish(TOPICS[event_type], payload)
+            conn.execute("UPDATE sales_outbox SET published_at = now() WHERE id = %s", (row_id,))
+            published += 1
+    return published
