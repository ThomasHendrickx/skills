+    def test_failed_payment_sends_no_receipt_and_leaves_no_outbox_row(self):
+        from unittest import mock
+        from src.sales.adapters.pg import StaleInvoice
+        self.invoice()
+        real = main.PgSalesUnitOfWork
+
+        class Racing(real):
+            def __enter__(self):
+                uow = super().__enter__()
+                get = uow.invoices.get
+
+                def get_then_race(invoice_id):  # a concurrent update lands after we read
+                    invoice = get(invoice_id)
+                    with main.connect() as other:
+                        other.execute("UPDATE invoices SET version = version + 1 WHERE id = 'i1'")
+                    return invoice
+                uow.invoices.get = get_then_race
+                return uow
+
+        with mock.patch.object(main, "PgSalesUnitOfWork", Racing):
+            with self.assertRaises(StaleInvoice):
+                main.pay_invoice("i1", date(2026, 11, 2))
+        self.assertEqual(self.rows("SELECT count(*) FROM sent_mail"), [(0,)])
+        self.assertEqual(self.rows("SELECT count(*) FROM sales_outbox WHERE type = 'InvoicePaid'"), [(0,)])
+
+    def test_relay_twice_sends_once(self):
+        self.invoice()
+        main.pay_invoice("i1", date(2026, 11, 2))
+        main.relay_outbox()
