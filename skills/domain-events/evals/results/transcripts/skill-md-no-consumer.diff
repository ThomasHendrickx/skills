diff -ruN -x __pycache__ -x '*.pyc' -x database.url base/src/sales/adapters/relay.py repo/src/sales/adapters/relay.py
--- base/src/sales/adapters/relay.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/src/sales/adapters/relay.py	2026-11-07 18:02:15.523150007 +0100
@@ -0,0 +1,22 @@
+"""Outbox relay: dispatches committed events, at least once. The only place that sends a receipt."""
+from src.db import connect
+from src.infra import mail
+
+
+def _dispatch(type_, payload):
+    if type_ == "InvoicePaid":
+        mail.send(f"{payload['customer_id']}@example.com", f"Receipt for invoice {payload['invoice_id']}",
+                  f"We received {payload['amount_cents'] / 100:.2f} on {payload['paid_on']}.")
+
+
+def relay_outbox() -> int:
+    """Send every undispatched event, then mark it. A crash between send and mark means a resend (at least once)."""
+    done = 0
+    with connect() as conn:
+        rows = conn.execute("SELECT id, type, payload FROM sales_outbox WHERE dispatched_at IS NULL ORDER BY id").fetchall()
+    for id_, type_, payload in rows:
+        _dispatch(type_, payload)
+        with connect() as conn:
+            conn.execute("UPDATE sales_outbox SET dispatched_at = now() WHERE id = %s", (id_,))
+        done += 1
+    return done
