+class PgProcessedEvents:
+    def __init__(self, conn):
+        self.conn = conn
+
+    def lock(self, invoice_id):
+        """Serialise concurrent deliveries for one invoice until the transaction ends."""
+        self.conn.execute("SELECT pg_advisory_xact_lock(hashtext(%s))", (invoice_id,))
+
+    def record(self, consumer, event_id):
+        """True if the event id was new."""
+        return self.conn.execute("INSERT INTO processed_events (consumer, event_id) VALUES (%s, %s)"
+                                 " ON CONFLICT DO NOTHING", (consumer, event_id)).rowcount == 1
+
+    def advance_version(self, consumer, invoice_id, version):
+        """True if version is newer than any seen for the invoice (and records it)."""
+        return self.conn.execute(
+            "INSERT INTO seen_invoice_versions (consumer, invoice_id, version) VALUES (%s, %s, %s)"
+            " ON CONFLICT (consumer, invoice_id) DO UPDATE SET version = EXCLUDED.version"
+            " WHERE seen_invoice_versions.version < EXCLUDED.version", (consumer, invoice_id, version)).rowcount == 1
+
+
