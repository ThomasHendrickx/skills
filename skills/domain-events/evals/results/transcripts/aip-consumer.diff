+
+def apply_invoice_event(uow, consumer: str, event_id: str, kind: str, invoice_id: str, order_id: str,
+                        invoice_version: int, on: date, fulfilment_id: str) -> bool:
+    """Apply a Sales invoice event once. Returns False when it was ignored (already processed, or older
+    than the invoice version already seen). The processed-event record is in the effect's transaction."""
+    if kind not in ("paid", "refunded"):
+        raise ValueError(f"unknown invoice event kind {kind!r}")
+    with uow:
+        uow.processed_events.lock(invoice_id)
+        if not uow.processed_events.record(consumer, event_id):
+            return False
+        if not uow.processed_events.advance_version(consumer, invoice_id, invoice_version):
+            return False
+        if kind == "paid":
+            uow.fulfilments.add(Fulfilment(fulfilment_id, order_id, on))
+        else:
+            for fulfilment in uow.fulfilments.for_order(order_id):
+                fulfilment.cancel()
+                uow.fulfilments.save(fulfilment)
+        return True
