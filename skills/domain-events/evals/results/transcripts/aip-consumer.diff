+
+
+def apply_invoice_event(uow, event_id: str, invoice_id: str, invoice_version: int, effect) -> bool:
+    """Run `effect(uow)` once per event, in the transaction that records the event as processed.
+
+    Returns False when the event was already processed or is older than the newest version seen for the invoice."""
+    with uow:
+        if not uow.inbox.claim(event_id):
+            return False
+        newest = uow.inbox.newest_version(invoice_id)
+        if newest is not None and invoice_version <= newest:
+            return False
+        uow.inbox.set_newest_version(invoice_id, invoice_version)
+        effect(uow)
+        return True
+
+
+def request_fulfilment_once(uow, fulfilment_id: str, order_id: str, on: date) -> None:
+    uow.fulfilments.add(Fulfilment(fulfilment_id, order_id, on))
+
+
+def cancel_fulfilments_of(uow, order_id: str) -> None:
+    for fulfilment in uow.fulfilments.for_order(order_id):
+        fulfilment.cancel()
+        uow.fulfilments.save(fulfilment)
