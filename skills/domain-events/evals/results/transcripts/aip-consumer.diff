+class PgInbox:
+    """Which events this consumer processed and the newest invoice version it has seen."""
+
+    def __init__(self, conn):
+        self.conn = conn
+
+    def claim(self, event_id):
+        row = self.conn.execute("INSERT INTO shipping_processed_events (event_id) VALUES (%s) ON CONFLICT DO NOTHING RETURNING event_id",
+                                (event_id,)).fetchone()
+        return row is not None
+
+    def newest_version(self, invoice_id):
+        row = self.conn.execute("SELECT version FROM shipping_invoice_versions WHERE invoice_id = %s FOR UPDATE", (invoice_id,)).fetchone()
+        return row[0] if row else None
+
+    def set_newest_version(self, invoice_id, version):
+        self.conn.execute("INSERT INTO shipping_invoice_versions (invoice_id, version) VALUES (%s, %s)"
+                          " ON CONFLICT (invoice_id) DO UPDATE SET version = EXCLUDED.version", (invoice_id, version))
+
+
