 );
+
+-- Shipping consumer of sales.invoices.v1: idempotency, ordering, retry and dead-letter.
+CREATE TABLE processed_events (
+    consumer text NOT NULL,
+    event_id text NOT NULL,
+    processed_at timestamptz NOT NULL DEFAULT now(),
+    PRIMARY KEY (consumer, event_id)
+);
+
+-- Highest invoice version Shipping has seen per invoice; older events are ignored.
+CREATE TABLE seen_invoice_versions (
+    consumer text NOT NULL,
+    invoice_id text NOT NULL,
+    version integer NOT NULL,
+    PRIMARY KEY (consumer, invoice_id)
+);
+
+-- Failed delivery attempts per bus message, until it succeeds or is dead-lettered.
+CREATE TABLE consumer_attempts (
+    consumer text NOT NULL,
+    message_id bigint NOT NULL,
+    attempts integer NOT NULL,
+    last_error text NOT NULL,
+    PRIMARY KEY (consumer, message_id)
+);
+
+-- Messages that will not be delivered again. A row here is the alert: ops must look at it.
+CREATE TABLE dead_letters (
+    id bigserial PRIMARY KEY,
+    consumer text NOT NULL,
+    topic text NOT NULL,
+    message_id bigint NOT NULL,
+    body jsonb NOT NULL,
+    attempts integer NOT NULL,
+    error text NOT NULL,
+    dead_lettered_at timestamptz NOT NULL DEFAULT now()
+);
