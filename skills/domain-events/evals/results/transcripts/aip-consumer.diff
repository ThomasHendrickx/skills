+-- Shipping's consumer of invoice events: what it processed (same transaction as the effect),
+-- the newest invoice version seen, delivery attempts and the dead-letter.
+CREATE TABLE shipping_processed_events (
+    event_id text PRIMARY KEY,
+    processed_at timestamptz NOT NULL DEFAULT now()
+);
+
+CREATE TABLE shipping_invoice_versions (
+    invoice_id text PRIMARY KEY,
+    version integer NOT NULL
+);
+
+CREATE TABLE shipping_delivery_attempts (
+    message_id bigint PRIMARY KEY,
+    attempts integer NOT NULL,
+    next_attempt_at timestamptz NOT NULL,
+    last_error text NOT NULL
+);
+
+CREATE TABLE shipping_dead_letters (
+    message_id bigint PRIMARY KEY,
+    body jsonb NOT NULL,
+    attempts integer NOT NULL,
+    error text NOT NULL,
+    dead_at timestamptz NOT NULL DEFAULT now(),
+    alerted boolean NOT NULL DEFAULT false
+);
