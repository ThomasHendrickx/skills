+class PgInvoiceEventLog:
+    """Which invoice events Shipping has applied, and the newest invoice version it has seen."""
+
+    def __init__(self, conn):
+        self.conn = conn
+
+    def first_time(self, consumer, event_id):
+        """Record the event id; False if it was already recorded (a redelivery)."""
+        row = self.conn.execute("INSERT INTO processed_events (consumer, event_id) VALUES (%s, %s)"
+                                " ON CONFLICT DO NOTHING RETURNING 1", (consumer, event_id)).fetchone()
+        return row is not None
+
+    def advance_version(self, invoice_id, version):
+        """Lock the invoice's row and move its seen version forward; False if `version` is not newer."""
+        self.conn.execute("INSERT INTO seen_invoice_versions (invoice_id, version) VALUES (%s, 0) ON CONFLICT DO NOTHING", (invoice_id,))
+        seen = self.conn.execute("SELECT version FROM seen_invoice_versions WHERE invoice_id = %s FOR UPDATE", (invoice_id,)).fetchone()[0]
+        if version <= seen:
+            return False
+        self.conn.execute("UPDATE seen_invoice_versions SET version = %s WHERE invoice_id = %s", (version, invoice_id))
+        return True
+
+
