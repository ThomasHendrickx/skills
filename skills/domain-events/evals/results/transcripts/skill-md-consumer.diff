+
+def apply_invoice_event(uow, consumer: str, event_id: str, invoice_id: str, version: int, action: str,
+                        order_id: str, on: date, fulfilment_id: str) -> bool:
+    """Apply a Sales invoice event ("request" or "cancel" fulfilment) at most once and never from an older invoice version.
+
+    The processed-event record, the seen version and the effect share one transaction. Returns whether the effect was applied."""
+    with uow:
+        if not uow.invoice_events.first_time(consumer, event_id):
+            return False
+        if not uow.invoice_events.advance_version(invoice_id, version):
+            return False
+        if action == "request":
+            uow.fulfilments.add(Fulfilment(fulfilment_id, order_id, on))
+        else:
+            for fulfilment in uow.fulfilments.for_order(order_id):
+                fulfilment.cancel()
+                uow.fulfilments.save(fulfilment)
+        return True
