+class PgInvoiceVersions:
+    def __init__(self, conn):
+        self.conn = conn
+
+    def get(self, consumer, invoice_id):
+        row = self.conn.execute("SELECT version FROM seen_invoice_versions WHERE consumer = %s AND invoice_id = %s FOR UPDATE",
