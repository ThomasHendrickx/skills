+
+
+def handle_invoice_event(uow, consumer: str, event: dict) -> bool:
+    """Apply one Sales invoice event once. Returns False when it was ignored (already processed or older than seen).
+
+    The processed-event record, the seen version and the effect share the unit of work's transaction."""
+    from src.contracts import sales_invoice_events as contract
+
+    with uow:
+        if not uow.processed_events.add(consumer, event["event_id"]):
+            return False
+        invoice_id, version = event["invoice_id"], event["invoice_version"]
+        seen = uow.invoice_versions.get(consumer, invoice_id)
+        if seen is not None and version <= seen:
+            return False
+        uow.invoice_versions.set(consumer, invoice_id, version)
+        if event["type"] == contract.INVOICE_PAID:
+            if not uow.fulfilments.for_order(event["order_id"]):
+                uow.fulfilments.add(Fulfilment(f"f-{uuid4().hex[:12]}", event["order_id"], date.fromisoformat(event["occurred_on"])))
+        elif event["type"] == contract.INVOICE_REFUNDED:
+            for fulfilment in uow.fulfilments.for_order(event["order_id"]):
+                fulfilment.cancel()
+                uow.fulfilments.save(fulfilment)
+        else:
+            raise ValueError(f"unknown event type {event['type']!r}")
+        return True
