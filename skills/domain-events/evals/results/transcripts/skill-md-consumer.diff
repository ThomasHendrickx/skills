+
+-- Shipping's invoice-event consumer: what it has processed, and the newest invoice version it has seen.
+CREATE TABLE processed_events (
+    consumer text NOT NULL,
+    event_id text NOT NULL,
+    PRIMARY KEY (consumer, event_id)
+);
+
+CREATE TABLE seen_invoice_versions (
+    consumer text NOT NULL,
+    invoice_id text NOT NULL,
+    version integer NOT NULL,
+    PRIMARY KEY (consumer, invoice_id)
+);
+
+-- Messages whose handler failed and will be tried again.
+CREATE TABLE consumer_retries (
+    consumer text NOT NULL,
+    message_id bigint NOT NULL,
+    body jsonb NOT NULL,
+    attempts integer NOT NULL,
+    last_error text NOT NULL,
+    next_attempt_at timestamptz NOT NULL,
+    PRIMARY KEY (consumer, message_id)
+);
+
+-- Messages that failed every attempt and will not be delivered again.
+CREATE TABLE dead_letters (
+    id bigserial PRIMARY KEY,
+    consumer text NOT NULL,
+    topic text NOT NULL,
+    message_id bigint NOT NULL,
+    body jsonb NOT NULL,
+    attempts integer NOT NULL,
+    last_error text NOT NULL,
+    dead_at timestamptz NOT NULL DEFAULT now()
+);
