+
+-- Shipping's consumer of Sales invoice events.
+-- Event ids already applied; written in the same transaction as the effect.
+CREATE TABLE processed_events (
+    consumer text NOT NULL,
+    event_id text NOT NULL,
+    processed_at timestamptz NOT NULL DEFAULT now(),
+    PRIMARY KEY (consumer, event_id)
+);
+
+-- Highest invoice aggregate version Shipping has seen per invoice; older events are ignored.
+CREATE TABLE seen_invoice_versions (
+    invoice_id text PRIMARY KEY,
+    version integer NOT NULL
+);
+
+-- Bus messages the handler failed on: retried when next_attempt_at has passed; dead_at set = dead-lettered, never delivered again.
+CREATE TABLE consumer_failures (
+    consumer text NOT NULL,
+    topic text NOT NULL,
+    message_id bigint NOT NULL,
+    attempts integer NOT NULL,
+    next_attempt_at timestamptz NOT NULL,
+    last_error text NOT NULL,
+    dead_at timestamptz,
+    alerted_at timestamptz,
+    PRIMARY KEY (consumer, topic, message_id)
+);
