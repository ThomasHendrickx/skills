+class PgProcessedEvents:
+    def __init__(self, conn):
+        self.conn = conn
+
+    def add(self, consumer, event_id) -> bool:
+        """Record the event id; False if it was already recorded."""
+        return self.conn.execute("INSERT INTO processed_events (consumer, event_id) VALUES (%s, %s) ON CONFLICT DO NOTHING",
+                                 (consumer, event_id)).rowcount == 1
+
