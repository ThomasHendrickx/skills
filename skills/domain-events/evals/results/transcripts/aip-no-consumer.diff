diff -ruN -x __pycache__ -x '*.pyc' -x database.url base/src/sales/adapters/relay.py repo/src/sales/adapters/relay.py
--- base/src/sales/adapters/relay.py	1970-01-01 01:00:00.000000000 +0100
+++ repo/src/sales/adapters/relay.py	2026-11-07 18:02:21.892085354 +0100
@@ -0,0 +1,27 @@
+"""Outbox relay: publishes sales_outbox rows after commit, at least once. A failed row is retried on the
+next run (attempts and last_error recorded). InvoicePaid becomes the customer's receipt mail."""
+from src.db import connect
+from src.infra import mail
+
+
+def _send(event_type, payload):
+    if event_type == "InvoicePaid":
+        mail.send(f"{payload['customer_id']}@example.com", f"Receipt for invoice {payload['invoice_id']}",
+                  f"We received {payload['amount_cents'] / 100:.2f} on {payload['paid_on']}.")
+
+
+def relay_outbox(limit: int = 100) -> int:
+    """Publish pending rows oldest first; returns how many were published."""
+    published = 0
+    with connect(autocommit=True) as conn:
+        rows = conn.execute("SELECT id, event_type, payload FROM sales_outbox WHERE processed_at IS NULL ORDER BY id LIMIT %s",
+                            (limit,)).fetchall()
+        for row_id, event_type, payload in rows:
+            try:
+                _send(event_type, payload)
+            except Exception as error:
+                conn.execute("UPDATE sales_outbox SET attempts = attempts + 1, last_error = %s WHERE id = %s", (str(error), row_id))
+                continue
+            conn.execute("UPDATE sales_outbox SET processed_at = now(), attempts = attempts + 1 WHERE id = %s", (row_id,))
+            published += 1
+    return published
